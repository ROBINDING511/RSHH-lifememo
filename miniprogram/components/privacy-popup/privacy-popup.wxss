.pp-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(9,8,86,.45); z-index: 99; display: flex; align-items: center; justify-content: center; }
.pp-card { width: 560rpx; background: var(--c-surface); border-radius: var(--r-card); padding: 40rpx 36rpx; }
.pp-title { display: block; font-size: var(--fs-lg); font-weight: 700; color: var(--c-text); }
.pp-body { display: block; margin-top: 16rpx; font-size: var(--fs-sm); line-height: 1.8; color: var(--c-text-soft); }
.pp-agree { margin-top: 28rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; background: var(--c-primary); color: var(--c-on-primary); border-radius: 999rpx; font-size: var(--fs-md); font-weight: 700; }
.pp-agree::after { border: none; }
.pp-refuse { margin-top: 12rpx; min-height: 72rpx; display: flex; align-items: center; justify-content: center; background: transparent; color: var(--c-text-soft); font-size: var(--fs-sm); }
.pp-refuse::after { border: none; }
