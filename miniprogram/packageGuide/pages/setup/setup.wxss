/* setup 指引页 */
.page { min-height: 100vh; }
.head { padding: 40rpx 32rpx 24rpx; }
.title { display: block; font-size: var(--fs-xl); font-weight: 500; color: var(--c-text); }
.sub { display: block; margin-top: 12rpx; font-size: var(--fs-sm); color: var(--c-text-2); line-height: 1.7; }
.card { margin: 0 32rpx 24rpx; background: var(--c-card); border: 2rpx solid var(--hairline); border-radius: var(--radius-lg); padding: 32rpx; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
.prof-title { display: block; font-size: var(--fs-md); font-weight: 500; color: var(--c-text); margin-bottom: 16rpx; }
.tip { display: block; margin-top: 12rpx; font-size: var(--fs-xs); color: var(--c-text-2); line-height: 1.6; }
.field { min-height: 88rpx; background: var(--c-soft); border: 2rpx solid var(--hairline); border-radius: var(--radius-md); padding: 0 24rpx; font-size: var(--fs-md); color: var(--c-text); box-sizing: border-box; }
.picker-field { display: flex; align-items: center; color: var(--c-primary); }
.mode-tabs { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.tab { padding: 10rpx 28rpx; border-radius: 24rpx; background: var(--c-soft); color: var(--c-text-2); font-size: var(--fs-sm); }
.tab.on { background: var(--c-primary-soft); color: var(--c-primary); }
.btns { padding: 8rpx 32rpx 24rpx; display: flex; flex-direction: column; gap: 16rpx; }
.btn-save { min-height: 96rpx; display: flex; align-items: center; justify-content: center; background: var(--c-primary); color: #fff; border-radius: var(--radius-md); font-size: var(--fs-lg); }
.btn-skip { min-height: 88rpx; display: flex; align-items: center; justify-content: center; color: var(--c-text-2); font-size: var(--fs-md); text-decoration: underline; }