/* packageGuide/pages/guide/guide.wxss — 首次引导（温暖水彩 · 适老化） */
.page { height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 0 48rpx; box-sizing: border-box; }

.g-step {
  margin-top: 24rpx; color: var(--c-text-2); font-size: var(--fs-sm);
  background: var(--c-card); border-radius: 32rpx; padding: 10rpx 32rpx;
  border: 2rpx solid rgba(31, 100, 120, 0.08);
}
.g-img { width: 460rpx; height: 460rpx; margin-top: 24rpx; flex-shrink: 0; }
.g-text { display: flex; flex-direction: column; align-items: center; margin-top: 24rpx; min-height: 220rpx; }
.g-title { font-size: var(--fs-xl); font-weight: 600; color: var(--c-text); text-align: center; }
.g-desc { align-self: stretch; font-size: var(--fs-md); color: var(--c-text-2); margin-top: 16rpx; line-height: 1.85; text-align: left; letter-spacing: 0.5rpx; }

.g-dots { display: flex; gap: 16rpx; margin-top: 20rpx; }
.dot { width: 18rpx; height: 18rpx; border-radius: 50%; background: #C9D8D6; }
.dot-done { background: #8FB6B4; }
.dot-on { background: var(--c-primary); width: 44rpx; border-radius: 9rpx; }

.g-btns { margin-top: auto; width: 100%; display: flex; flex-direction: column; align-items: center; gap: 20rpx; padding-bottom: 24rpx; }
.g-row { display: flex; gap: 24rpx; width: 100%; }
.g-prev { flex: 0 0 240rpx; }
.g-next { flex: 1; }
.g-next-full { width: 100%; }

/* "跳过"要看得见、点得准 */
.g-skip {
  min-height: 88rpx; padding: 0 40rpx;
  display: flex; align-items: center; justify-content: center;
  color: var(--c-primary); font-size: var(--fs-sm); font-weight: 500;
  background: var(--c-card); border-radius: 44rpx;
  border: 2rpx solid #BFD8D6; box-sizing: border-box;
}
.g-skip.btn-hover { background: var(--c-primary-soft); }

/* 年纪设置（生日/年龄/出生年 三选一） */
.g-profile { width: 100%; margin-top: 24rpx; }
.mode-tabs { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.tab { flex: 1; min-height: 72rpx; display: flex; align-items: center; justify-content: center; background: var(--c-card); color: var(--c-text-2); border-radius: 36rpx; font-size: var(--fs-sm); border: 2rpx solid rgba(31,100,120,.1); }
.tab.on { background: var(--c-primary); color: #fff; border-color: var(--c-primary); }
.prof-input { min-height: 88rpx; display: flex; align-items: center; justify-content: center; background: var(--c-card); border: 2rpx solid rgba(31,100,120,.15); border-radius: var(--radius-md); color: var(--c-primary); font-size: var(--fs-md); font-weight: 500; text-align: center; }
.g-privacy { display: block; margin-top: 16rpx; font-size: var(--fs-xs); color: var(--c-text-2); text-align: center; }