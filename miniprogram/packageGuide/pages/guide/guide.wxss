/* packageGuide/pages/guide/guide.wxss */
.page {
  height: 100vh; display: flex; flex-direction: column;
  align-items: center; justify-content: center; padding: 0 60rpx;
}
.g-img { width: 520rpx; height: 520rpx; }
.g-text { display: flex; flex-direction: column; align-items: center; margin-top: 40rpx; }
.g-title { font-size: 44rpx; font-weight: 500; color: #2C3E50; }
.g-desc { font-size: 30rpx; color: #7A93A6; margin-top: 16rpx; line-height: 1.8; text-align: center; }
.g-dots { display: flex; gap: 12rpx; margin-top: 60rpx; }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #CFE6F4; }
.dot-on { background: #4A9BD1; width: 36rpx; border-radius: 8rpx; }
.g-btns {
  position: fixed; left: 60rpx; right: 60rpx; bottom: 80rpx;
  display: flex; flex-direction: column; align-items: center; gap: 24rpx;
}
.g-skip { color: #A8C4D6; font-size: 28rpx; }
.g-next { width: 100%; }
