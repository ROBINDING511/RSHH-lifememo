/* packageGuide/pages/guide/guide.wxss — 适老化样式 */
.page {
  height: 100vh; display: flex; flex-direction: column;
  align-items: center; padding: 0 48rpx; box-sizing: border-box;
}

.g-step {
  margin-top: 24rpx;
  color: var(--c-text-2); font-size: var(--fs-sm);
  background: #fff; border-radius: 32rpx; padding: 10rpx 32rpx;
}

.g-img { width: 460rpx; height: 460rpx; margin-top: 24rpx; flex-shrink: 0; }

.g-text {
  display: flex; flex-direction: column; align-items: center;
  margin-top: 24rpx; min-height: 220rpx;
}
.g-title { font-size: 48rpx; font-weight: 500; color: var(--c-text); text-align: center; }
.g-desc {
  font-size: var(--fs-md); color: var(--c-text-2);
  margin-top: 16rpx; line-height: 1.8; text-align: center;
}

.g-dots { display: flex; gap: 16rpx; margin-top: 20rpx; }
.dot { width: 18rpx; height: 18rpx; border-radius: 50%; background: #C3D9E8; }
.dot-done { background: #8FB6D2; }
.dot-on { background: var(--c-primary); width: 44rpx; border-radius: 9rpx; }

.g-btns {
  margin-top: auto;
  width: 100%;
  display: flex; flex-direction: column; align-items: center; gap: 20rpx;
  padding-bottom: 24rpx;
}
.g-row { display: flex; gap: 24rpx; width: 100%; }
.g-prev { flex: 0 0 240rpx; }
.g-next { flex: 1; }
.g-next-full { width: 100%; }

/* "跳过"要看得见、点得准（原 #A8C4D6 对比度仅 1.63:1） */
.g-skip {
  min-height: 88rpx; padding: 0 40rpx;
  display: flex; align-items: center; justify-content: center;
  color: var(--c-primary); font-size: var(--fs-sm); font-weight: 500;
  background: #fff; border-radius: 44rpx;
  border: 2rpx solid #CFE0EC;
  box-sizing: border-box;
}
.g-skip.btn-hover { background: var(--c-primary-soft); }
