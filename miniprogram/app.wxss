/* app.wxss — 全局设计系统：温暖手绘水彩 · 空灵海面（适老化）
 *
 * 视觉语言：暖纸底 + 海青主色 + 纸白卡片 + 柔和圆角，呼应 ocean 的水彩海面/白冰山/小鲸鱼。
 * 配色按 WCAG 2.2 AA 核算：
 *   主色   #1F6478  白字  6.66:1
 *   正文   #33424E  纸白 10.08:1
 *   次要   #5A6B76  纸白  5.39:1 / 暖底 4.94:1
 *   危险   #B3402F  白字  5.69:1
 *   倒计时 #B3261E  白字  6.54:1
 */
page {
  /* ---- 色彩（水彩海面系）---- */
  --c-primary: #1F6478;        /* 海青主色：按钮底、强调 */
  --c-primary-deep: #17505F;   /* 按压态 */
  --c-primary-soft: #E3EEEF;   /* 浅青底（chip、幽灵按钮） */
  --c-bg: #F5F2EA;             /* 暖纸底 */
  --c-card: #FDFCF9;           /* 纸白卡片 */
  --c-soft: #F1EDE3;           /* 暖浅功能底 */
  --c-sand: #E8DCC8;           /* 沙色点缀 */
  --c-teal-wash: #E2EDEB;      /* 渐变末端淡海 */

  --c-text: #33424E;           /* 暖墨正文/标题 */
  --c-text-2: #5A6B76;         /* 暖灰次要 */
  --c-on-primary: #FFFFFF;

  --c-danger: #B3402F;         /* 暖珊瑚危险（化成云） */
  --c-danger-soft: #F7E8E4;
  --c-countdown: #B3261E;

  /* ---- 鸟瞰海面场景（ocean 用）---- */
  --sea-0: #C9E7ED;
  --sea-1: #ACD7DF;
  --sea-2: #8CBFCC;
  --sea-3: #6FA6B8;
  --sea-4: #548EA4;
  --sea-5: #417C95;
  --sea-6: #387089;
  --sea-warm-rgb: 255, 243, 214;
  --sea-deep-rgb: 20, 56, 76;
  --caustic-rgb: 255, 249, 230;
  --hint-cap-rgb: 16, 48, 66;
  --ripple-rgb: 255, 255, 255;
  --c-bird: #26404F;

  /* ---- 字号（适老放大：最小 30rpx，正文 38rpx+，转写 54rpx）---- */
  --fs-xs: 30rpx;
  --fs-sm: 32rpx;
  --fs-md: 38rpx;
  --fs-lg: 42rpx;
  --fs-xl: 46rpx;
  --fs-xxl: 54rpx;

  /* ---- 触控（≥88rpx ≈44px）---- */
  --tap-min: 88rpx;
  --tap-comfortable: 96rpx;

  /* ---- 间距 ---- */
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;
  --sp-5: 40rpx;

  /* ---- 圆角（柔和手绘感）---- */
  --radius-md: 24rpx;
  --radius-lg: 36rpx;
  --radius-xl: 52rpx;

  background: var(--c-bg);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: var(--fs-md);
  color: var(--c-text);
  line-height: 1.8;
  letter-spacing: 0.5rpx;
}

/* 子页面共用：暖纸→淡海 柔和渐变底 + 顶部一点晨光 */
.wash-bg {
  background:
    radial-gradient(120% 30% at 50% -6%, rgba(var(--sea-warm-rgb), .35) 0%, rgba(var(--sea-warm-rgb), 0) 60%),
    linear-gradient(180deg, #F7F3EA 0%, #F0F4F1 50%, var(--c-teal-wash) 100%);
}

/* ============ 按钮 ============ */
.btn-primary {
  background: var(--c-primary);
  color: var(--c-on-primary);
  border-radius: 48rpx;
  font-size: var(--fs-lg);
  height: 112rpx;
  line-height: 112rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 100, 120, 0.22);
}
.btn-primary::after { border: none; }
.btn-primary.btn-hover { background: var(--c-primary-deep); transform: scale(0.97); }

.btn-ghost {
  background: var(--c-primary-soft);
  color: var(--c-primary);
  border-radius: 48rpx;
  font-size: var(--fs-md);
  height: 104rpx;
  line-height: 104rpx;
  font-weight: 500;
}
.btn-ghost::after { border: none; }
.btn-ghost.btn-hover { background: #D3E4E5; transform: scale(0.97); }

.btn-danger-ghost { background: var(--c-danger-soft); color: var(--c-danger); }
.btn-danger-ghost.btn-hover { background: #F0D9D2; transform: scale(0.97); }

/* ============ 纸卡片 ============ */
.card {
  background: var(--c-card);
  border-radius: var(--radius-lg);
  padding: var(--sp-4);
  border: 2rpx solid rgba(31, 100, 120, 0.06);
  box-shadow: 0 8rpx 28rpx rgba(31, 100, 120, 0.10);
}

.text-secondary { color: var(--c-text-2); font-size: var(--fs-sm); }
.text-large { font-size: var(--fs-lg); line-height: 1.7; }
.flex1 { flex: 1; }

.safe-bottom { padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx); }