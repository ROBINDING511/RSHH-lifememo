/* app.wxss — 全局设计系统（unslop _redesign 分支）
 * 方向：安静、温暖、不催促。世界=水彩纸与海。
 * 铬件（导航/按钮/卡片/文字）全部安静纸面 + 单一墨青强调；
 * 富色只留在唯一的内容时刻——ocean 的日落水彩海与鲸鱼。
 * 暖中性阶（warm ramp）+ 发丝描边 + 中性微阴影；无 hue 渐变/无彩 glow/无 emoji。
 * 适老化保留：正文≥34rpx、触控≥88rpx、字重 400/500。
 * unslop by @heydamir (CC BY 4.0) 方法适配。
 */
page {
  /* ---- 暖中性阶（纸）---- */
  --c-bg: #F7F4EE;             /* 页面底 */
  --c-card: #FDFBF7;           /* 卡片 */
  --c-soft: #EFE9DF;           /* raised：输入/次按钮/active */
  --hairline: rgba(31, 27, 22, 0.08);  /* 发丝描边 = 主文字 8% */

  /* ---- 单一强调（海青，世界=水）---- */
  --c-primary: #1F6478;        /* 白字 6.66:1 */
  --c-primary-deep: #17505F;   /* 按压 */
  --c-primary-soft: #E3EEEF;   /* 强调浅底（选中） */
  --c-on-primary: #FFFFFF;

  /* ---- 文字三档 ---- */
  --c-text: #1F1B16;           /* 主 */
  --c-text-2: #5E554A;         /* 次 */
  --c-muted: #7B7266;          /* 弱（仅 meta） */

  /* ---- 语义（ toned ）---- */
  --c-danger: #B3402F;
  --c-danger-soft: #F7E8E4;
  --c-countdown: #B3261E;

  /* ---- 兼容旧引用 ---- */
  --c-sand: #E8DCC8;
  --c-teal-wash: #E2EDEB;
  --sea-warm-rgb: 255, 243, 214;
  --sea-deep-rgb: 20, 56, 76;
  --caustic-rgb: 255, 249, 230;
  --hint-cap-rgb: 16, 48, 66;
  --ripple-rgb: 255, 255, 255;
  --c-bird: #26404F;
  --sea-0: #C9E7ED; --sea-1: #ACD7DF; --sea-2: #8CBFCC; --sea-3: #6FA6B8;
  --sea-4: #548EA4; --sea-5: #417C95; --sea-6: #387089;

  /* ---- 字号（适老阶梯）---- */
  --fs-xs: 30rpx;
  --fs-sm: 30rpx;
  --fs-md: 34rpx;
  --fs-lg: 36rpx;
  --fs-xl: 40rpx;
  --fs-xxl: 48rpx;

  /* ---- 触控 ---- */
  --tap-min: 88rpx;
  --tap-comfortable: 96rpx;

  /* ---- 间距（8rpx=4px 网格）---- */
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;
  --sp-5: 40rpx;

  /* ---- 圆角（控制10px/卡片12px/面板16px，非全 pill）---- */
  --radius-md: 20rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;

  background: var(--c-bg);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: var(--fs-md);
  color: var(--c-text);
  line-height: 1.8;
  letter-spacing: 0;
}

/* 子页面底：安静纸面（去掉彩色渐变 wash） */
.wash-bg { background: var(--c-bg); }

/* ============ 按钮：实心强调 / raised+发丝 / 语义软底 ============ */
.btn-primary {
  display: flex; align-items: center; justify-content: center;
  background: var(--c-primary);
  color: var(--c-on-primary);
  border-radius: var(--radius-md);
  font-size: var(--fs-lg);
  height: 96rpx;
  line-height: 1;
  font-weight: 500;
  letter-spacing: 0;
}
.btn-primary::after { border: none; }
.btn-primary.btn-hover { background: var(--c-primary-deep); transform: scale(0.98); }

.btn-ghost {
  display: flex; align-items: center; justify-content: center;
  background: var(--c-soft);
  border: 2rpx solid var(--hairline);
  color: var(--c-text);
  border-radius: var(--radius-md);
  font-size: var(--fs-md);
  height: 88rpx;
  line-height: 1;
  font-weight: 500;
  box-sizing: border-box;
}
.btn-ghost::after { border: none; }
.btn-ghost.btn-hover { background: #E7E0D4; transform: scale(0.98); }

.btn-danger-ghost { background: var(--c-danger-soft); border-color: rgba(179, 64, 47, 0.16); color: var(--c-danger); }
.btn-danger-ghost.btn-hover { background: #F2DED8; transform: scale(0.98); }

/* ============ 纸卡片：发丝描边 + 中性微阴影 ============ */
.card {
  background: var(--c-card);
  border-radius: var(--radius-lg);
  padding: var(--sp-5);
  border: 2rpx solid var(--hairline);
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}

.text-secondary { color: var(--c-text-2); font-size: var(--fs-sm); }
.text-large { font-size: var(--fs-lg); line-height: 1.7; }
.flex1 { flex: 1; }

.safe-bottom { padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx); }