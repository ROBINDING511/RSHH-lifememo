<!--pages/ocean/ocean.wxml — 人生海洋主界面（空灵俯视插画海面）
    渲染：一张轻量插画空海背景 + 复用的顶视冰山 sprite + 顶视小鲸鱼，CSS transform 动画。
    冰山=回忆，随波摇曳；鲸鱼杭航在冰山间游弋（自然微动）。弱网先出渐变兜底再淡入插画。
    分层：z3 远冰 → z5 鲸鱼 → z7 中冰 → z9 近冰 → z20 UI。
    适老化：录音主入口=底部大按钮（点一下开始/说完了再点）；长按鲸鱼=副入口；
    关键信息原生 view/text；空态提示深色胶囊白字；冰山视觉虽小但热区 ≥88rpx。
-->
<view class="page" bindtouchend="onSceneTouchEnd">

  <!-- ============ 插画海面场景 ============ -->
  <view class="scene" bindtouchstart="onSceneTouchStart">
    <view class="bg-gradient"></view>
    <image class="bg-art {{bgLoaded ? 'show' : ''}}" src="/images/ocean/sea_bg.jpg"
      mode="aspectFill" bindload="onBgLoad" />
    <view class="caustic c1"></view>
    <view class="caustic c2"></view>

    <!-- z3 远冰（小淡） -->
    <view class="layer z-far">
      <view wx:for="{{farBergs}}" wx:key="id" class="berg"
        style="left:{{item.left}}%;top:{{item.top}}%;width:{{item.width}}px;opacity:{{item.opacity}};animation:{{item.anim}}"
        data-id="{{item.id}}" bindtap="onBergTap" hover-class="berg-hover" hover-stay-time="80">
        <image class="berg-img" src="/images/ocean/berg.png" mode="widthFix" />
      </view>
    </view>

    <!-- z5 鲸鱼杭航：在冰山间游弋 + 自然微动；长按说话副入口 -->
    <view class="layer z-whale">
      <view class="cruise {{whalePaused || recording ? 'paused' : ''}}">
        <view class="whalebox" bindlongpress="onWhaleLongPress" hover-class="whale-hover" hover-stay-time="80">
          <image class="whale-img" src="/images/ocean/whale.png" mode="aspectFit" />
        </view>
      </view>
    </view>

    <!-- z7 中冰（鲸鱼从这些冰山后面穿过；新回忆落这里） -->
    <view class="layer z-mid">
      <view wx:for="{{midBergs}}" wx:key="id" class="berg"
        style="left:{{item.left}}%;top:{{item.top}}%;width:{{item.width}}px;opacity:{{item.opacity}};animation:{{item.anim}}"
        data-id="{{item.id}}" bindtap="onBergTap" hover-class="berg-hover" hover-stay-time="80">
        <image class="berg-img" src="/images/ocean/berg.png" mode="widthFix" />
      </view>
    </view>

    <!-- z9 近冰（大） -->
    <view class="layer z-near">
      <view wx:for="{{nearBergs}}" wx:key="id" class="berg"
        style="left:{{item.left}}%;top:{{item.top}}%;width:{{item.width}}px;opacity:{{item.opacity}};animation:{{item.anim}}"
        data-id="{{item.id}}" bindtap="onBergTap" hover-class="berg-hover" hover-stay-time="80">
        <image class="berg-img" src="/images/ocean/berg.png" mode="widthFix" />
      </view>
    </view>
  </view>

  <!-- ============ 草稿找回（说过的话绝不丢） ============ -->
  <view class="draft-bar" wx:if="{{drafts.length && !recording && !preview}}"
    style="top: {{capsuleBottom + 16}}px;">
    <view class="draft-text">有 {{drafts.length}} 段话没存好</view>
    <view class="draft-btn" hover-class="btn-hover" hover-stay-time="80" bindtap="recoverDraft">找回来</view>
  </view>

  <!-- ============ 空态提示（深色胶囊白字，压在任何水色上都看得清） ============ -->
  <view class="empty-hint" wx:if="{{icebergCount === 0 && !recording && !preview && !drafts.length}}">
    <view class="hint-card">
      <text class="hint-title">想说什么，就说给杭航听</text>
      <text class="hint-sub">点下面的蓝色按钮，或者长按小鲸鱼</text>
      <text class="hint-sub2">您说的每一句话，都会变成一座冰山</text>
    </view>
    <view class="hint-arrow"></view>
  </view>

  <!-- ============ 底部操作区（拇指区） ============ -->
  <view class="dock safe-bottom" wx:if="{{!recording && !analyzing && !preview}}">
    <view class="dock-row">
      <view class="dock-pill" hover-class="btn-hover" hover-stay-time="80" bindtap="goTimeline">
        <image src="/images/pixel/flag-blue.png" class="dock-icon" mode="aspectFit" />
        <text>时间轴</text>
      </view>
      <view class="dock-pill" hover-class="btn-hover" hover-stay-time="80" bindtap="goRecycle">
        <image src="/images/misc/cloud.png" class="dock-icon" mode="aspectFit" />
        <text>云朵</text>
      </view>
    </view>
    <view class="record-btn" hover-class="record-hover" hover-stay-time="80" bindtap="toggleRecord">
      <image class="record-whale" src="/images/misc/recording-whale.png" mode="aspectFit" />
      <view class="record-label">
        <text class="record-main">点这里说话</text>
        <text class="record-sub">说完再点一下"说完了"就好</text>
      </view>
    </view>
  </view>

  <!-- ============ 录音中（原生渲染，可随微信字体放大） ============ -->
  <view class="record-mask {{recordMode === 'hold' ? 'mask-through' : 'mask-block'}}" wx:if="{{recording}}">
    <view class="rec-status">
      <view class="rec-dot"></view>
      <text class="rec-state">杭航正在听您说…</text>
      <text class="asr-hint" wx:if="{{asrHint === 'connecting'}}">正在连线，字马上就来</text>
      <text class="asr-hint asr-hint-warn" wx:elif="{{asrHint === 'offline'}}">字暂时不出来，别急，说完松手会自动整理好</text>
    </view>

    <view class="transcript-box">
      <scroll-view scroll-y class="transcript-scroll" scroll-into-view="t-end">
        <text class="transcript">{{transcript || '正在听，您慢慢说…'}}</text>
        <text id="t-end"></text>
      </scroll-view>
    </view>

    <view class="rec-timer">
      <text class="timer-main">已说 {{elapsed}} 秒</text>
      <view class="countdown-box" wx:if="{{countdown > 0}}">
        <text class="countdown-num">{{countdown}}</text>
        <text class="countdown-label">秒后自动结束</text>
      </view>
      <text class="timer-limit" wx:else>最长可说 {{maxSeconds}} 秒</text>
    </view>

    <view class="rec-hold-hint" wx:if="{{recordMode === 'hold'}}">
      <text>松开手，就说完啦</text>
    </view>

    <view class="rec-actions safe-bottom" wx:else>
      <view class="rec-cancel" hover-class="btn-hover" hover-stay-time="80" bindtap="cancelRecording">不录了</view>
      <view class="rec-done" hover-class="btn-hover" hover-stay-time="80" bindtap="finishRecording">说完了</view>
    </view>
  </view>

  <!-- ============ 分析中 ============ -->
  <view class="analyze-mask" wx:if="{{analyzing}}">
    <image class="loading-whale" src="/images/animation/whale-loading-1.png" mode="aspectFit" />
    <text class="analyze-text">杭航正在听懂这段回忆…</text>
    <text class="analyze-sub">大概要几秒钟，别急</text>
  </view>

  <!-- ============ 发布卡片 ============ -->
  <view class="preview-mask" wx:if="{{preview}}">
    <view class="preview-card safe-bottom">
      <view class="preview-head">
        <text class="preview-title">这段回忆</text>
        <text class="preview-hint">看一遍，有错字可以直接改</text>
      </view>

      <textarea class="preview-text" value="{{preview.text}}" maxlength="2000"
        auto-height cursor-spacing="120" show-confirm-bar="{{false}}"
        bindinput="onPreviewInput"
        placeholder="没听清的话，也可以在这里打字补上"></textarea>

      <view class="voice-check" wx:if="{{preview.wavPath}}"
        hover-class="btn-hover" hover-stay-time="80" bindtap="playPreviewVoice">
        <view class="vc-btn {{previewVoicePlaying ? 'vc-on' : ''}}"></view>
        <text class="vc-text">{{previewVoicePlaying ? '正在播放，点这里停' : '听听我自己的声音'}}</text>
      </view>

      <view class="option-group" wx:if="{{preview.timeOptions.length}}">
        <text class="option-label">大概是这个时候</text>
        <view class="chips">
          <view wx:for="{{preview.timeOptions}}" wx:key="*this"
            class="chip {{preview.timeIndex === index ? 'chip-on' : ''}}"
            hover-class="chip-hover" hover-stay-time="80"
            data-i="{{index}}" bindtap="pickTime">{{item}}</view>
        </view>
      </view>

      <view class="option-group" wx:if="{{preview.zoneOptions.length}}">
        <text class="option-label">放进哪片海</text>
        <view class="chips">
          <view wx:for="{{preview.zoneOptions}}" wx:key="*this"
            class="chip {{preview.zoneIndex === index ? 'chip-on' : ''}}"
            hover-class="chip-hover" hover-stay-time="80"
            data-i="{{index}}" bindtap="pickZone">{{item}}</view>
        </view>
      </view>

      <view class="photo-group">
        <text class="option-label">配上照片（点图片看大图，点右上角 × 删掉）</text>
        <view class="photo-grid">
          <view class="photo-cell" wx:for="{{preview.photos}}" wx:key="*this">
            <image src="{{item}}" mode="aspectFill" class="photo-img"
              data-i="{{index}}" bindtap="previewDraftPhoto" />
            <view class="photo-del" hover-class="del-hover" hover-stay-time="80"
              data-i="{{index}}" catchtap="removePhoto">
              <text class="photo-del-x">×</text>
            </view>
          </view>
          <view class="photo-add" wx:if="{{preview.photos.length < 9}}"
            hover-class="btn-hover" hover-stay-time="80" bindtap="addPhoto">
            <text class="photo-add-plus">＋</text>
            <text class="photo-add-text">加照片</text>
          </view>
        </view>
      </view>

      <view class="preview-actions">
        <button class="btn-ghost btn-danger-ghost flex1" hover-class="btn-hover"
          hover-stay-time="80" bindtap="discardPreview">不要了</button>
        <button class="btn-primary flex1" hover-class="btn-hover"
          hover-stay-time="80" loading="{{publishing}}" disabled="{{publishing}}"
          bindtap="publish">变成冰山</button>
      </view>
    </view>
  </view>
</view>