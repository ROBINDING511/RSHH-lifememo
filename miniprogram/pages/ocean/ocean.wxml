<!--pages/ocean/ocean.wxml — 人生海洋主界面（空灵俯视插画海面）
    渲染：一张轻量插画空海背景 + 复用的顶视冰山 sprite + 顶视小鲸鱼，CSS transform 动画。
    冰山=回忆，随波摇曳；鲸鱼杭航在冰山间游弋（自然微动）。弱网先出渐变兜底再淡入插画。
    分层：z3 远冰 → z5 鲸鱼 → z7 中冰 → z9 近冰 → z20 UI。
    适老化：录音主入口=底部大按钮（点一下开始/说完了再点）；长按鲸鱼=副入口；
    关键信息原生 view/text；空态提示深色胶囊白字；冰山视觉虽小但热区 ≥88rpx。
-->
<view class="page" bindtouchend="onSceneTouchEnd">

  <!-- ============ 插画海面场景 ============ -->
  <view class="scene" bindtouchstart="onSceneTouchStart">
    <view class="bg-gradient"></view>
    <image class="bg-art {{bgLoaded ? 'show' : ''}}" src="/images/ocean/sea_bg.jpg"
      mode="aspectFill" bindload="onBgLoad" />


    <!-- 整片海向四面八方扩展：2D 可拖世界，拖动如滚地球（海面纹理随世界滚过+各阶段海色晕染） -->
    <movable-area class="sea-area">
      <movable-view class="sea-world" direction="all" inertia damping="{{40}}" friction="{{2}}"
        out-of-bounds="{{false}}" disabled="{{movableDisabled}}" bindchange="onSeaChange"
        scale="{{true}}" scale-min="0.6" scale-max="2.5" scale-value="{{seaScale}}" bindscale="onSeaScale"
        style="width:{{worldWidth}}px;height:{{worldHeight}}px" x="{{movX}}" y="{{movY}}">
        <image class="sea-texture" src="/images/ocean/sea_bg.jpg" mode="scaleToFill"
          style="width:{{worldWidth+120}}px;height:{{worldHeight+120}}px" />

        <view class="sea-tint" style="background:{{tintGradient}}"></view>
        <text wx:for="{{stages}}" wx:key="key" class="stage-label"
          style="left:{{item.cx}}px;top:{{item.cy}}px">{{item.name}}之海</text>
        <view wx:for="{{bergs}}" wx:key="id" class="berg"
          style="left:{{item.left}}px;top:{{item.top}}px;width:{{item.width}}px;opacity:{{item.opacity}};animation:{{item.anim}}"
          data-id="{{item.id}}" data-i="{{index}}" bindtap="onBergTap"
          bindlongpress="onBergDragStart" bindtouchmove="onBergDragMove" bindtouchend="onBergDragEnd"
          hover-class="berg-hover" hover-stay-time="80">
          <image class="berg-img" src="/images/ocean/berg.png" mode="widthFix" />
          <view class="berg-flag" wx:if="{{item.flag}}"></view>
        </view>
        <!-- 自定义人生节点：小旗标记 -->
        <view wx:for="{{milestones}}" wx:key="id" class="ms-marker" style="left:{{item.left}}px;top:{{item.top}}px">
          <view class="ms-flag"></view>
          <text class="ms-label">{{item.name}}·{{item.age}}岁</text>
        </view>
      </movable-view>
    </movable-area>
    <!-- 球面曲率暗角：滚动如滚地球的边缘收暗 -->
    <view class="sea-curve"></view>

    <!-- 鲸鱼杭航：屏幕层游弋（始终可见）+ 自然微动；长按说话副入口 -->
    <view class="whale-layer">
      <view class="cruise {{whalePaused || recording ? 'paused' : ''}}">
        <view class="whalebox" bindtap="onWhaleTap" bindlongpress="onWhaleLongPress" hover-class="whale-hover" hover-stay-time="80">
          <image class="wf wf-straight" src="/images/ocean/whale.png" mode="aspectFit" />
        </view>
      </view>
    </view>
  </view>

  <!-- ============ 草稿找回（说过的话绝不丢） ============ -->
  <view class="draft-bar" wx:if="{{drafts.length && !recording && !preview}}"
    style="top: {{capsuleBottom + 16}}px;">
    <view class="draft-text">有 {{drafts.length}} 段话没存好</view>
    <view class="draft-btn" hover-class="btn-hover" hover-stay-time="80" bindtap="recoverDraft">找回来</view>
  </view>

  <!-- ============ 空态提示（深色胶囊白字，压在任何水色上都看得清） ============ -->
  <view class="empty-hint" wx:if="{{icebergCount === 0 && !recording && !preview && !drafts.length}}">
    <view class="hint-card">
      <text class="hint-title">{{prompt || '想说什么，就说给杭航听'}}</text>
      <text class="hint-sub">按住下面的青色按钮，说说看</text>
      <view class="hint-next" hover-class="btn-hover" hover-stay-time="80" bindtap="nextPrompt">换一个问题</view>
    </view>
    <view class="hint-arrow"></view>
  </view>

  <!-- 那年今日：托起一座旧冰山 -->
  <view class="today-bar" wx:if="{{todayMemory && !recording && !preview}}"
    style="top: {{capsuleBottom + 16}}px;" hover-class="btn-hover" hover-stay-time="80" bindtap="openToday">
    <text>{{todayMemory.yearsAgo}}年前的今天 · {{todayMemory.title}}</text>
  </view>

  <!-- 家人视角 / 反应回流 -->
  <view class="today-bar" wx:if="{{familyOwner && !recording && !preview}}" style="top: {{capsuleBottom + 16}}px;">
    <text>你在看家人的海 · 点冰山可"想听/抱抱"</text>
  </view>
  <view class="today-bar react-chip" wx:if="{{familyReactCount > 0 && !familyOwner && !recording && !preview && !todayMemory}}" style="top: {{capsuleBottom + 16}}px;">
    <text>杭航想听/抱抱了 {{familyReactCount}} 次</text>
  </view>

  <!-- 右上角声音开关（录音时自动静音） -->
  <view class="sound-btn {{ambientOn && !recording ? '' : 'muted'}}" wx:if="{{!preview}}"
    style="top: {{capsuleBottom + 16}}px;"
    hover-class="btn-hover" hover-stay-time="80" bindtap="toggleAmbient"></view>

  <!-- 杭航请妈妈试听克隆声音：像→固化；不像→继续克隆 -->
  <view class="voice-review" wx:if="{{voiceReview && !recording && !preview}}">
    <view class="vr-card">
      <text class="vr-title">杭航把您的声音克隆好了</text>
      <text class="vr-sub">听听像不像您？像就固化下来</text>
      <view class="vr-play" hover-class="btn-hover" hover-stay-time="80" bindtap="playVoiceSample">▶ 试听克隆声音</view>
      <view class="vr-btns">
        <view class="vr-like" hover-class="btn-hover" hover-stay-time="80" bindtap="voiceLike">像，固化</view>
        <view class="vr-unlike" hover-class="btn-hover" hover-stay-time="80" bindtap="voiceUnlike">不像</view>
      </view>
    </view>
  </view>

  <!-- ============ 底部操作区（拇指区） ============ -->
  <view class="dock safe-bottom" wx:if="{{!preview}}">
    <view class="record-btn {{recording ? (cancelArmed ? 'record-cancel' : 'record-on') : ''}}"
      hover-class="record-hover" hover-stay-time="80"
      bindtouchstart="onHoldStart" bindtouchmove="onHoldMove"
      catchtouchend="onHoldEnd" catchtouchcancel="onHoldEnd">
      <text class="record-main">{{recording ? (cancelArmed ? '松开 取消' : '松开 发送') : '按住 说话'}}</text>
    </view>
  </view>

  <!-- ============ 实时转写面板（微信式：按住即弹 0 延迟，边说边出字）============
       pointer-events:none，不抢按钮触摸；松手发送 / 上滑取消。原生 text 可随微信字体放大。 -->
  <view class="live-mask" wx:if="{{recording}}">
    <view class="live-card {{cancelArmed ? 'live-cancel' : ''}}">
      <view class="live-status">
        <view class="live-dot"></view>
        <text class="live-state">{{cancelArmed ? '松开手指，取消' : '正在听，松手发送'}}</text>
        <text class="live-timer">{{elapsed}}s</text>
      </view>
      <text class="live-asr" wx:if="{{asrHint === 'connecting'}}">正在连线，字马上就来</text>
      <text class="live-asr live-asr-warn" wx:elif="{{asrHint === 'offline'}}">字暂时不出来，别急，松手会自动整理好</text>
      <scroll-view scroll-y class="live-scroll" scroll-into-view="t-end">
        <text class="live-text">{{transcript || '您慢慢说，字马上出来…'}}</text>
        <text id="t-end"></text>
      </scroll-view>
      <view class="live-countdown" wx:if="{{countdown > 0}}">
        <text class="live-countdown-num">{{countdown}}</text>
        <text class="live-countdown-label">秒后自动结束</text>
      </view>
      <text class="live-hint">{{cancelArmed ? '松开即取消，话会存进草稿' : '上滑取消 · 松手发送'}}</text>
    </view>
  </view>

  <!-- ============ 发布卡片 ============ -->
  <view class="preview-mask" wx:if="{{preview}}">
    <view class="preview-card safe-bottom {{sheetSettle ? 'sheet-settle' : ''}}" style="transform: translateY({{sheetDy}}px)">
      <view class="sheet-grip" catchtouchstart="onSheetStart" catchtouchmove="onSheetMove"
        catchtouchend="onSheetEnd" catchtouchcancel="onSheetEnd">
        <view class="sheet-grip-bar"></view>
      </view>
      <textarea class="preview-text" value="{{preview.text}}" maxlength="2000"
        auto-height cursor-spacing="120" show-confirm-bar="{{false}}"
        bindinput="onPreviewInput"
        placeholder="这一刻的想法…（有错字可以直接改）"></textarea>

      <!-- 润色可回退：默认逐字，AI 小标题可选 -->
      <view class="polish-row">
        <view class="polish-toggle {{preview.showTitle ? 'on' : ''}}" hover-class="btn-hover" hover-stay-time="80" bindtap="toggleTitle">AI 小标题·{{preview.showTitle ? '开' : '关'}}</view>
        <view class="polish-revert" hover-class="btn-hover" hover-stay-time="80" bindtap="revertRaw">还原逐字</view>
      </view>

      <!-- 照片：微信式九宫格，裸 + 添加，无多余解释文案 -->
      <view class="photo-grid">
        <view class="photo-cell" wx:for="{{preview.photos}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill" class="photo-img"
            data-i="{{index}}" bindtap="previewDraftPhoto" />
          <view class="photo-del" hover-class="del-hover" hover-stay-time="80"
            data-i="{{index}}" catchtap="removePhoto">
            <text class="photo-del-x">×</text>
          </view>
        </view>
        <view class="photo-add" wx:if="{{preview.photos.length < 9}}"
          hover-class="btn-hover" hover-stay-time="80" bindtap="addPhoto">
          <text class="photo-add-plus">＋</text>
        </view>
      </view>

      <!-- 微信式 cell：什么时候 / 哪片海，点开选择（有真实预设可选） -->
      <!-- 什么时候 == 哪片海：只选一次；听到的年份/岁数仅作只读提示 -->
      <text class="time-hint" wx:if="{{preview.timeLabel}}">听到 {{preview.timeLabel}}，落在</text>
      <view class="meta-cell" hover-class="cell-hover" hover-stay-time="80" bindtap="pickZoneSheet">
        <text class="meta-label">哪片海</text>
        <text class="meta-value">{{preview.zoneOptions[preview.zoneIndex]}}之海</text>
        <text class="meta-arrow">›</text>
      </view>

      <view class="voice-check" wx:if="{{preview.wavPath}}"
        hover-class="btn-hover" hover-stay-time="80" bindtap="playPreviewVoice">
        <view class="vc-btn {{previewVoicePlaying ? 'vc-on' : ''}}"></view>
        <text class="vc-text">{{previewVoicePlaying ? '正在播放，点这里停' : '听听我自己的声音'}}</text>
      </view>

      <view class="continue-hold" hover-class="btn-hover" hover-stay-time="80"
        bindtouchstart="onContinueStart" catchtouchend="onContinueEnd" catchtouchcancel="onContinueEnd">
        <text>没说完？按住继续说</text>
      </view>

      <view class="preview-actions">
        <button class="btn-ghost btn-danger-ghost flex1" hover-class="btn-hover"
          hover-stay-time="80" bindtap="discardPreview">不要了</button>
        <button class="btn-primary flex1" hover-class="btn-hover"
          hover-stay-time="80" loading="{{publishing}}" disabled="{{publishing}}"
          bindtouchstart="tapHaptic" bindtap="publish">变成冰山</button>
      </view>
    </view>
  </view>
</view>