/* pages/ocean/ocean.wxss — 空灵俯视插画海面
 * 一张轻量插画空海背景 + 复用顶视冰山 sprite + 顶视小鲸鱼。
 * 只动画 transform / opacity（GPU 合成，冰山多也不卡）；无运行时滤镜。
 * 弱网：CSS 渐变兜底先出，插画背景加载后淡入。场景色引用 app.wxss --sea-* token。
 * 触控 ≥88rpx；录音/发布 UI 沿用适老化定稿。
 */
.page { width: 100vw; height: 100vh; position: relative; overflow: hidden; }

/* ============ 场景层 ============ */
.scene { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; }
/* 弱网/加载兜底：插画未到位时先显示柔和海面渐变 */
.bg-gradient {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, var(--sea-0) 0%, var(--sea-2) 30%, var(--sea-4) 65%, var(--sea-6) 100%);
}
.bg-art { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0; transition: opacity .8s ease; }
.bg-art.show { opacity: 1; }
/* 焦散光斑：让海面「活」起来，radial-gradient 柔边不用滤镜 */
.caustic { position: absolute; border-radius: 50%; opacity: .1; background: radial-gradient(circle, rgba(var(--caustic-rgb), .8) 0%, rgba(var(--caustic-rgb), 0) 70%); }
.c1 { left: 10%; top: 24%; width: 300rpx; height: 140rpx; animation: caust 19s ease-in-out infinite; }
.c2 { left: 55%; top: 50%; width: 360rpx; height: 160rpx; animation: caust 26s ease-in-out -8s infinite; }
@keyframes caust { 0%, 100% { transform: translateX(0) scaleX(1); opacity: .07; } 50% { transform: translateX(30rpx) scaleX(1.1); opacity: .13; } }

/* 整片海 2D 世界：四面八方可拖（滚地球），海面纹理随世界滚过 + 阶段海色晕染 + 曲率暗角 */
.sea-area { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.sea-world { position: relative; }
.sea-texture { position: absolute; left: 0; top: 0; }
.sea-tint { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: .5; pointer-events: none; }
/* 浪：极淡波光两层异速漂移，轻轻的水动（一个波纹周期=120rpx，循环无缝） */
.sea-ripple { position: absolute; left: -60rpx; top: 0; width: calc(100% + 120rpx); height: 100%; pointer-events: none; }
.sea-ripple.r1 { background: repeating-linear-gradient(6deg, rgba(255,255,255,0) 0 60rpx, rgba(255,255,255,.06) 60rpx 64rpx, rgba(255,255,255,0) 64rpx 120rpx); animation: rippleDrift 26s linear infinite; }
.sea-ripple.r2 { background: repeating-linear-gradient(-5deg, rgba(255,255,255,0) 0 90rpx, rgba(255,255,255,.04) 90rpx 95rpx, rgba(255,255,255,0) 95rpx 180rpx); animation: rippleDrift2 40s linear infinite; }
@keyframes rippleDrift { from { transform: translateX(0); } to { transform: translateX(120rpx); } }
@keyframes rippleDrift2 { from { transform: translateX(0); } to { transform: translateX(-180rpx); } }
.stage-label { position: absolute; transform: translate(-50%, -50%); color: rgba(18,58,72,.85); background: rgba(255,255,255,.55); padding: 8rpx 28rpx; border-radius: 32rpx; font-size: var(--fs-sm); font-weight: 600; letter-spacing: 6rpx; pointer-events: none; }
.sea-curve { position: absolute; left: 0; top: 0; right: 0; bottom: 0; pointer-events: none; background: radial-gradient(ellipse at 50% 45%, rgba(20,56,76,0) 55%, rgba(20,56,76,.30) 100%); }
/* 人生节点小旗 */
.ms-marker { position: absolute; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; pointer-events: none; }
.ms-flag { width: 4rpx; height: 48rpx; background: rgba(18,58,72,.55); position: relative; }
.ms-flag::after { content: ''; position: absolute; top: 0; left: 4rpx; border-top: 14rpx solid transparent; border-bottom: 14rpx solid transparent; border-left: 20rpx solid rgba(179,64,47,.8); }
.ms-label { margin-top: 6rpx; font-size: var(--fs-xs); color: rgba(18,58,72,.85); background: rgba(255,255,255,.6); padding: 2rpx 14rpx; border-radius: 20rpx; white-space: nowrap; }
.whale-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 5; pointer-events: none; }
.whale-layer .whalebox { pointer-events: auto; }

/* ============ 冰山（回忆，随波摇曳）============ */
.berg { position: absolute; transform-origin: 50% 55%; pointer-events: auto; will-change: transform; }
.berg-img { display: block; width: 100%; }
.berg-hover { opacity: .82; }
@keyframes sway { 0%, 100% { transform: rotate(-2deg) translate(0, 0); } 50% { transform: rotate(2deg) translate(3rpx, 4rpx); } }
@keyframes bergdrop { 0% { transform: scale(2.1); opacity: 0; } 55% { transform: scale(.93); opacity: 1; } 100% { transform: scale(1); } }

/* ============ 鲸鱼杭航（冰山间游弋 + 自然微动）============ */
.cruise { position: absolute; left: 0; top: 0; width: 0; height: 0; animation: cruise 38s ease-in-out infinite; will-change: transform; }
.whalebox { position: absolute; left: -70rpx; top: -115rpx; width: 140rpx; height: 230rpx; pointer-events: auto; transform-origin: 50% 22%; animation: whalebob 2.4s ease-in-out infinite; }
/* 摆尾游动：尾姿之间用 ease-in-out 交叉渐变（逐渐弯曲、无硬切），叠加身体连续起伏 → 灵动不机械 */
.wf { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0; }
.wf-straight { animation: wfs 2.4s ease-in-out infinite; }
.wf-left { animation: wfl 2.4s ease-in-out infinite; }
.wf-right { animation: wfr 2.4s ease-in-out infinite; }
@keyframes wfs { 0% { opacity: 1; } 25% { opacity: 0; } 50% { opacity: 1; } 75% { opacity: 0; } 100% { opacity: 1; } }
@keyframes wfl { 0% { opacity: 0; } 25% { opacity: 1; } 50% { opacity: 0; } 100% { opacity: 0; } }
@keyframes wfr { 0% { opacity: 0; } 50% { opacity: 0; } 75% { opacity: 1; } 100% { opacity: 0; } }
.whale-hover { opacity: .85; }
.cruise.paused, .cruise.paused .whalebox, .cruise.paused .wf { animation-play-state: paused; }
@keyframes cruise {
  0% { transform: translate(300rpx, 520rpx); }
  20% { transform: translate(480rpx, 640rpx); }
  40% { transform: translate(200rpx, 700rpx); }
  60% { transform: translate(420rpx, 820rpx); }
  80% { transform: translate(160rpx, 600rpx); }
  100% { transform: translate(300rpx, 520rpx); }
}
@keyframes whalebob {
  0%, 100% { transform: rotate(-3deg) translateY(0) scaleX(1); }
  25% { transform: rotate(0deg) translateY(-4rpx) scaleX(0.98); }
  50% { transform: rotate(3deg) translateY(-7rpx) scaleX(0.96); }
  75% { transform: rotate(0deg) translateY(-4rpx) scaleX(0.98); }
}

/* ============ 空态提示（深色胶囊白字，全渐变达标）============ */
.empty-hint { position: absolute; left: 40rpx; right: 40rpx; top: 24%; display: flex; flex-direction: column; align-items: center; pointer-events: none; z-index: 20; }
.hint-card { display: flex; flex-direction: column; align-items: center; background: rgba(var(--hint-cap-rgb), .72); border-radius: var(--radius-lg); padding: 32rpx 36rpx; }
.hint-title { font-size: var(--fs-xl); color: #FFFFFF; font-weight: 500; text-align: center; }
.hint-sub { font-size: var(--fs-md); color: #FFFFFF; margin-top: 16rpx; text-align: center; font-weight: 500; }
.hint-sub2 { font-size: var(--fs-sm); color: rgba(255, 255, 255, .85); margin-top: 8rpx; text-align: center; }
.hint-arrow { width: 4rpx; height: 88rpx; margin-top: 24rpx; background: rgba(255, 255, 255, .85); position: relative; }
.hint-arrow::after { content: ''; position: absolute; bottom: -4rpx; left: 50%; transform: translateX(-50%); border-left: 18rpx solid transparent; border-right: 18rpx solid transparent; border-top: 26rpx solid rgba(255, 255, 255, .85); }

/* ============ 首次问生日 ============ */
.bd-mask { position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 40; background: rgba(23,80,95,.45); display: flex; align-items: center; justify-content: center; padding: 0 48rpx; }
.bd-card { width: 100%; background: var(--c-card); border-radius: var(--radius-lg); padding: 40rpx 36rpx; box-shadow: 0 12rpx 40rpx rgba(23,80,95,.25); }
.bd-title { display: block; font-size: var(--fs-xl); font-weight: 600; color: var(--c-text); }
.bd-sub { display: block; font-size: var(--fs-sm); color: var(--c-text-2); margin-top: 12rpx; line-height: 1.6; }
.bd-picker { margin-top: 28rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; background: var(--c-soft); border: 2rpx solid rgba(31,100,120,.15); border-radius: var(--radius-md); color: var(--c-primary); font-size: var(--fs-md); font-weight: 500; }
.bd-btns { display: flex; gap: 24rpx; margin-top: 32rpx; }
.bd-skip { flex: 1; min-height: 88rpx; display: flex; align-items: center; justify-content: center; background: var(--c-soft); color: var(--c-text-2); border-radius: 44rpx; font-size: var(--fs-md); }
.bd-ok { flex: 1; min-height: 88rpx; display: flex; align-items: center; justify-content: center; background: linear-gradient(160deg,#2E7C93,#1F6478); color: #fff; border-radius: 44rpx; font-size: var(--fs-md); font-weight: 500; }

/* ============ 草稿找回（沿用定稿）============ */
.draft-bar { position: absolute; left: 24rpx; right: 24rpx; z-index: 21; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; background: #FFF6E5; border: 2rpx solid #E8C77A; border-radius: var(--radius-lg); padding: 20rpx 16rpx 20rpx 28rpx; }
.draft-text { color: #7A5410; font-size: var(--fs-sm); font-weight: 500; }
.draft-btn { min-width: 180rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; background: #96650F; color: #fff; border-radius: 44rpx; font-size: var(--fs-sm); font-weight: 500; }
.draft-btn.btn-hover { background: #7A5009; }

/* ============ 底部操作区（沿用定稿）============ */
.dock { position: absolute; left: 0; right: 0; bottom: 0; z-index: 20; display: flex; flex-direction: column; gap: 20rpx; padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 48rpx); }
.dock-row { display: flex; justify-content: center; gap: 24rpx; }
.dock-pill { display: flex; align-items: center; gap: 12rpx; min-height: 88rpx; padding: 0 40rpx; background: rgba(255,255,255,0.95); border-radius: 44rpx; color: var(--c-primary); font-size: var(--fs-sm); font-weight: 500; box-shadow: 0 4rpx 16rpx rgba(36,100,143,0.14); }
.dock-pill.btn-hover { background: var(--c-primary-soft); transform: scale(0.97); }
.dock-icon { width: 48rpx; height: 48rpx; }
/* 微信式细长条：单行居中，干净简洁；高度 96rpx 仍 ≥88rpx 触控下限 */
.record-btn { display: flex; align-items: center; justify-content: center; min-height: 96rpx; padding: 0 36rpx; background: linear-gradient(160deg, #2E7C93 0%, #1F6478 55%, #1A5A6C 100%); border-radius: 48rpx; box-shadow: 0 4rpx 16rpx rgba(31,100,120,0.20); }
.record-btn.record-hover { background: linear-gradient(160deg, #256A80 0%, #17505F 100%); transform: scale(0.98); }
.record-btn.record-on { background: linear-gradient(160deg, #256A80 0%, #17505F 100%); }
.record-btn.record-cancel { background: linear-gradient(160deg, #C4574A 0%, #B3402F 100%); }
.record-main { color: #fff; font-size: var(--fs-lg); font-weight: 500; letter-spacing: 6rpx; line-height: 1.2; }

/* ============ 实时转写面板（微信式按住说话，0 延迟弹出）============ */
.live-mask { position: absolute; left: 0; right: 0; bottom: calc(env(safe-area-inset-bottom) + 160rpx); z-index: 35; display: flex; justify-content: center; padding: 0 32rpx; pointer-events: none; }
.live-card { width: 100%; background: rgba(253,252,249,0.97); border-radius: var(--radius-lg); padding: 28rpx 32rpx; box-shadow: 0 12rpx 40rpx rgba(23,80,95,0.22); border: 2rpx solid rgba(31,100,120,0.08); }
.live-card.live-cancel { background: rgba(247,232,228,0.97); border-color: rgba(179,64,47,0.25); }
.live-status { display: flex; align-items: center; gap: 14rpx; }
.live-dot { width: 20rpx; height: 20rpx; border-radius: 50%; background: var(--c-danger); animation: rec-pulse 1.2s ease-in-out infinite; }
@keyframes rec-pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.45; transform: scale(0.82); } }
.live-state { flex: 1; color: var(--c-text); font-size: var(--fs-md); font-weight: 600; }
.live-cancel .live-state { color: var(--c-danger); }
.live-timer { color: var(--c-text-2); font-size: var(--fs-sm); }
.live-asr { display: block; color: var(--c-text-2); font-size: var(--fs-xs); margin-top: 8rpx; }
.live-asr-warn { color: #8A5A15; }
.live-scroll { max-height: 360rpx; margin-top: 16rpx; }
.live-text { color: var(--c-text); font-size: var(--fs-xxl); line-height: 1.6; letter-spacing: 1rpx; }
.live-countdown { display: flex; align-items: baseline; gap: 10rpx; margin-top: 12rpx; }
.live-countdown-num { color: var(--c-countdown); font-size: 64rpx; font-weight: 700; line-height: 1; }
.live-countdown-label { color: var(--c-countdown); font-size: var(--fs-sm); font-weight: 500; }
.live-hint { display: block; text-align: center; color: var(--c-text-2); font-size: var(--fs-xs); margin-top: 16rpx; letter-spacing: 1rpx; }
.live-cancel .live-hint { color: var(--c-danger); }

/* ============ 发布卡片 ============ */
.preview-mask { position: absolute; left: 0; right: 0; top: 0; bottom: 0; z-index: 30; background: rgba(15,58,92,0.5); display: flex; align-items: flex-end; }
.preview-card { width: 100%; background: #fff; border-radius: var(--radius-xl) var(--radius-xl) 0 0; padding: 40rpx 36rpx 40rpx; box-sizing: border-box; max-height: 88vh; overflow-y: auto; }
.preview-text { width: 100%; min-height: 200rpx; font-size: var(--fs-lg); line-height: 1.7; color: var(--c-text); padding: 28rpx; box-sizing: border-box; background: var(--c-soft); border-radius: var(--radius-md); border: 2rpx solid #DCE9F2; }
/* 照片九宫格：微信式，灰底裸 + ，无解释文案 */
.photo-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; }
.photo-cell { position: relative; width: 200rpx; height: 200rpx; }
.photo-img { width: 200rpx; height: 200rpx; border-radius: 8rpx; }
.photo-del { position: absolute; top: -16rpx; right: -16rpx; width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--c-danger); border: 4rpx solid #fff; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.photo-del.del-hover { background: #9E2B20; transform: scale(1.08); }
.photo-del-x { color: #fff; font-size: 40rpx; line-height: 1; margin-top: -4rpx; }
.photo-add { width: 200rpx; height: 200rpx; border-radius: 8rpx; background: #F2F3F5; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.photo-add.btn-hover { background: #E5E6E8; }
.photo-add-plus { color: #9AA0A6; font-size: 72rpx; line-height: 1; font-weight: 300; }
/* 微信式 meta cell：左标签 / 右值 / 箭头，点开 action sheet */
.time-hint { display: block; margin-top: 20rpx; font-size: var(--fs-sm); color: var(--c-text-2); }
.meta-cell { display: flex; align-items: center; min-height: 96rpx; padding: 0 8rpx; border-bottom: 2rpx solid rgba(31, 100, 120, 0.08); }
.meta-cell.cell-hover { background: var(--c-soft); }
.meta-label { flex: 0 0 160rpx; color: var(--c-text); font-size: var(--fs-md); }
.meta-value { flex: 1; text-align: right; color: var(--c-text-2); font-size: var(--fs-md); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.meta-arrow { color: #B0B8BF; font-size: 40rpx; margin-left: 12rpx; line-height: 1; }
.voice-check { display: flex; align-items: center; gap: 20rpx; min-height: 96rpx; margin-top: 20rpx; padding: 0 28rpx; background: var(--c-primary-soft); border-radius: var(--radius-md); }
.voice-check.btn-hover { background: #DCE9F2; }
.vc-btn { width: 56rpx; height: 56rpx; border-radius: 50%; background: var(--c-primary); position: relative; flex-shrink: 0; }
.vc-btn::after { content: ''; position: absolute; top: 50%; left: 54%; transform: translate(-50%,-50%); border-top: 12rpx solid transparent; border-bottom: 12rpx solid transparent; border-left: 18rpx solid #fff; }
.vc-on { background: var(--c-danger); }
.vc-on::after { border: none; width: 18rpx; height: 22rpx; background: #fff; top: 50%; left: 50%; transform: translate(-50%,-50%); border-radius: 3rpx; }
.vc-text { color: var(--c-primary); font-size: var(--fs-sm); font-weight: 500; }
.continue-hold { margin-top: 24rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; border: 2rpx dashed rgba(31,100,120,.4); border-radius: 44rpx; color: var(--c-primary); font-size: var(--fs-md); }
.preview-actions { display: flex; gap: 24rpx; margin-top: 24rpx; }

/* 提示脚手架 / 那年今日 / 润色回退 */
.hint-next { pointer-events: auto; margin-top: 16rpx; padding: 6rpx 24rpx; border-radius: 28rpx; background: rgba(255,255,255,.18); color: #fff; font-size: var(--fs-xs); }
.today-bar { position: absolute; left: 24rpx; right: 140rpx; z-index: 21; background: rgba(253,252,249,.92); border: 2rpx solid rgba(31,100,120,.15); border-radius: 32rpx; padding: 14rpx 24rpx; color: var(--c-primary); font-size: var(--fs-sm); box-shadow: 0 4rpx 16rpx rgba(31,100,120,.12); }
.today-bar text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; }
.react-chip { background: rgba(247,232,228,.95); border-color: rgba(179,64,47,.25); color: var(--c-danger); }
.polish-row { display: flex; gap: 16rpx; margin-top: 16rpx; }
.polish-toggle { padding: 8rpx 24rpx; border-radius: 28rpx; background: var(--c-soft); color: var(--c-text-2); font-size: var(--fs-xs); }
.polish-toggle.on { background: var(--c-primary-soft); color: var(--c-primary); }
.polish-revert { padding: 8rpx 24rpx; border-radius: 28rpx; background: var(--c-soft); color: var(--c-text-2); font-size: var(--fs-xs); text-decoration: underline; }

/* ============ 减少动态效果：全停，静态显示 ============ */
@media (prefers-reduced-motion: reduce) {
  .caustic, .cruise, .whalebox, .wf, .berg, .live-dot, .sea-ripple { animation: none !important; }
  .wf-straight { opacity: 1; }
  .bg-art { transition: none; }
  .record-btn.record-hover, .dock-pill.btn-hover { transform: none; }
}