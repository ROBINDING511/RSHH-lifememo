/* pages/ocean/ocean.wxss — 适老化样式
 * 触控目标一律 ≥ 88rpx（≈44px，WCAG 2.2 Target Size AA）
 * 顶部位置由 JS 注入 capsuleBottom，避开状态栏与微信胶囊
 */
.page { width: 100vw; height: 100vh; position: relative; overflow: hidden; }
.ocean-canvas { width: 100vw; height: 100vh; }

/* ============ 顶部（左侧，右上角留白给胶囊） ============ */
.top-zone {
  position: absolute; left: 24rpx;
  display: flex; align-items: center; gap: 20rpx;
  background: rgba(255,255,255,0.94); border-radius: 40rpx;
  padding: 10rpx 12rpx 10rpx 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(36,100,143,0.12);
}
.back-btn {
  display: flex; align-items: center; gap: 4rpx;
  min-height: 88rpx; padding: 0 28rpx;
  border-radius: 44rpx;
  color: var(--c-primary); font-size: var(--fs-sm); font-weight: 500;
  background: var(--c-primary-soft);
}
.back-btn.btn-hover { background: #DCE9F2; }
.back-arrow { font-size: 40rpx; line-height: 1; margin-right: 2rpx; }
.zone-name { color: var(--c-text); font-size: var(--fs-md); font-weight: 500; padding-right: 16rpx; }

/* ============ 草稿找回 ============ */
.draft-bar {
  position: absolute; left: 24rpx; right: 24rpx;
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  background: #FFF6E5; border: 2rpx solid #E8C77A;
  border-radius: var(--radius-lg); padding: 20rpx 16rpx 20rpx 28rpx;
}
.draft-text { color: #7A5410; font-size: var(--fs-sm); font-weight: 500; }
.draft-btn {
  min-width: 180rpx; min-height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  background: #96650F; color: #fff; border-radius: 44rpx;
  font-size: var(--fs-sm); font-weight: 500;
}
.draft-btn.btn-hover { background: #7A5009; }

/* ============ 空态提示 ============ */
.empty-hint {
  position: absolute; left: 40rpx; right: 40rpx; top: 26%;
  display: flex; flex-direction: column; align-items: center;
  pointer-events: none;
}
.hint-title { font-size: var(--fs-xl); color: #1F5580; font-weight: 500; text-align: center; }
.hint-sub { font-size: var(--fs-md); color: var(--c-text-2); margin-top: 20rpx; text-align: center; font-weight: 500; }
.hint-sub2 { font-size: var(--fs-sm); color: var(--c-text-2); margin-top: 8rpx; text-align: center; }
.hint-arrow {
  width: 4rpx; height: 96rpx; margin-top: 32rpx;
  background: var(--c-primary); position: relative;
}
.hint-arrow::after {
  content: ''; position: absolute; bottom: -4rpx; left: 50%;
  transform: translateX(-50%);
  border-left: 18rpx solid transparent;
  border-right: 18rpx solid transparent;
  border-top: 26rpx solid var(--c-primary);
}

/* ============ 底部操作区 ============ */
.dock {
  position: absolute; left: 0; right: 0; bottom: 0;
  display: flex; flex-direction: column; gap: 20rpx;
  padding: 20rpx 32rpx 16rpx;
}
.dock-row { display: flex; justify-content: center; gap: 24rpx; }
.dock-pill {
  display: flex; align-items: center; gap: 12rpx;
  min-height: 88rpx; padding: 0 40rpx;
  background: rgba(255,255,255,0.95); border-radius: 44rpx;
  color: var(--c-primary); font-size: var(--fs-sm); font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(36,100,143,0.14);
}
.dock-pill.btn-hover { background: var(--c-primary-soft); transform: scale(0.97); }
.dock-icon { width: 48rpx; height: 48rpx; }

/* 录音主按钮：96rpx 高起步，实际 132rpx，全宽好按 */
.record-btn {
  display: flex; align-items: center; gap: 24rpx;
  min-height: 132rpx; padding: 0 36rpx;
  background: var(--c-primary); border-radius: 66rpx;
  box-shadow: 0 8rpx 28rpx rgba(36,100,143,0.32);
}
.record-btn.record-hover { background: var(--c-primary-deep); transform: scale(0.98); }
.record-whale { width: 84rpx; height: 84rpx; flex-shrink: 0; }
.record-label { display: flex; flex-direction: column; gap: 2rpx; }
.record-main { color: #fff; font-size: var(--fs-lg); font-weight: 500; letter-spacing: 1rpx; }
.record-sub { color: #CFE3F2; font-size: var(--fs-xs); }

/* ============ 录音中 ============ */
/* 关键：遮罩本身必须穿透触摸，否则"长按鲸鱼说话"松手时 touchend 传不回 canvas，
   录音停不下来。只有底部按钮层单独接收触摸。 */
.record-mask {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  display: flex; flex-direction: column; justify-content: flex-end;
  background: rgba(15,58,92,0.62);
}
/* 长按模式：遮罩穿透，松手的 touchend 才能传回 canvas 结束录音 */
.mask-through { pointer-events: none; }
.mask-through .rec-actions,
.mask-through .rec-hold-hint { pointer-events: auto; }
/* 点按模式：遮罩拦截，避免误碰海面缩放或误入冰山详情 */
.mask-block { pointer-events: auto; }
.rec-status {
  display: flex; align-items: center; justify-content: center; gap: 16rpx;
  margin-bottom: 20rpx;
}
.rec-dot {
  width: 22rpx; height: 22rpx; border-radius: 50%;
  background: #E24B4A; animation: rec-pulse 1.2s ease-in-out infinite;
}
@keyframes rec-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.45; transform: scale(0.82); }
}
/* 尊重系统"减少动态效果"：保留呼吸灯但不闪烁，避免眩晕 */
@media (prefers-reduced-motion: reduce) {
  .rec-dot { animation: none; }
  .record-btn.record-hover,
  .dock-pill.btn-hover,
  .rec-done.btn-hover { transform: none; }
}
.rec-state { color: #fff; font-size: var(--fs-md); font-weight: 500; }

/* 实时识别状态提示：换行显示在"正在听"下方，老人一眼看懂当前情况 */
.rec-status { flex-wrap: wrap; }
.asr-hint {
  flex-basis: 100%; text-align: center;
  color: rgba(255, 255, 255, 0.8);
  font-size: var(--fs-sm); line-height: 1.4;
  margin-top: 4rpx;
}
.asr-hint-warn { color: #FFD98E; }

.transcript-box {
  margin: 0 32rpx; background: #1A4E77;
  border-radius: var(--radius-lg); padding: 32rpx;
  min-height: 200rpx; max-height: 460rpx;
}
.transcript-scroll { max-height: 400rpx; }
.transcript { color: #fff; font-size: var(--fs-xxl); line-height: 1.65; }

.rec-timer {
  display: flex; flex-direction: column; align-items: center;
  margin: 24rpx 0;
}
.timer-main { color: #fff; font-size: var(--fs-lg); font-weight: 500; }
.timer-limit { color: #B8D4E8; font-size: var(--fs-sm); margin-top: 6rpx; }
.timer-warn { color: #FFD9D5; font-weight: 500; }

.rec-actions {
  display: flex; gap: 24rpx; padding: 0 32rpx 16rpx;
  pointer-events: auto;   /* 遮罩穿透，仅按钮层接收触摸 */
}
/* 长按模式：手指占着屏幕，只显示提示，不放按钮 */
.rec-hold-hint {
  display: flex; align-items: center; justify-content: center;
  min-height: 112rpx; margin: 0 32rpx 16rpx;
  background: rgba(255,255,255,0.16);
  border: 2rpx solid rgba(255,255,255,0.42);
  border-radius: 56rpx;
  color: #fff; font-size: var(--fs-lg); font-weight: 500;
}
.rec-cancel {
  flex: 0 0 200rpx; min-height: 112rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,0.18); border: 2rpx solid rgba(255,255,255,0.5);
  border-radius: 56rpx; color: #fff; font-size: var(--fs-md);
}
.rec-cancel.btn-hover { background: rgba(255,255,255,0.3); }
.rec-done {
  flex: 1; min-height: 112rpx;
  display: flex; align-items: center; justify-content: center;
  background: #fff; border-radius: 56rpx;
  color: var(--c-primary); font-size: var(--fs-xl); font-weight: 500;
}
.rec-done.btn-hover { background: #EAF2F8; transform: scale(0.98); }

/* ============ 分析中 ============ */
.analyze-mask {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: rgba(232,244,251,0.94);
}
.loading-whale { width: 240rpx; height: 160rpx; margin-bottom: 32rpx; }
.analyze-text { color: var(--c-text); font-size: var(--fs-lg); font-weight: 500; }
.analyze-sub { color: var(--c-text-2); font-size: var(--fs-sm); margin-top: 12rpx; }

/* ============ 发布卡片 ============ */
.preview-mask {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(15,58,92,0.5);
  display: flex; align-items: flex-end;
}
.preview-card {
  width: 100%; background: #fff; border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: 40rpx 36rpx 40rpx; box-sizing: border-box;
  max-height: 88vh; overflow-y: auto;
}
.preview-head { margin-bottom: 20rpx; }
.preview-title { display: block; font-size: var(--fs-xl); font-weight: 500; color: var(--c-text); }
.preview-hint { display: block; font-size: var(--fs-sm); color: var(--c-text-2); margin-top: 8rpx; }

.preview-text {
  width: 100%; min-height: 200rpx;
  font-size: var(--fs-lg); line-height: 1.7; color: var(--c-text);
  padding: 28rpx; box-sizing: border-box;
  background: var(--c-soft); border-radius: var(--radius-md);
  border: 2rpx solid #DCE9F2;
}

/* 原声回听 */
.voice-check {
  display: flex; align-items: center; gap: 20rpx;
  min-height: 96rpx; margin-top: 20rpx; padding: 0 28rpx;
  background: var(--c-primary-soft); border-radius: var(--radius-md);
}
.voice-check.btn-hover { background: #DCE9F2; }
.vc-btn {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: var(--c-primary); position: relative; flex-shrink: 0;
}
.vc-btn::after {
  content: ''; position: absolute; top: 50%; left: 54%;
  transform: translate(-50%,-50%);
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  border-left: 18rpx solid #fff;
}
.vc-on { background: var(--c-danger); }
.vc-on::after {
  border: none; width: 18rpx; height: 22rpx; background: #fff;
  top: 50%; left: 50%; transform: translate(-50%,-50%); border-radius: 3rpx;
}
.vc-text { color: var(--c-primary); font-size: var(--fs-sm); font-weight: 500; }

.option-group { margin-top: 32rpx; }
.option-label { display: block; font-size: var(--fs-sm); color: var(--c-text-2); font-weight: 500; }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.chip {
  display: flex; align-items: center; justify-content: center;
  min-height: 88rpx; padding: 0 36rpx;
  background: var(--c-primary-soft); color: var(--c-primary);
  border: 2rpx solid transparent;
  border-radius: 44rpx; font-size: var(--fs-sm); font-weight: 500;
  box-sizing: border-box;
}
.chip.chip-hover { background: #DCE9F2; }
/* 选中态不只靠颜色：加深底色 + 白字 + 前置勾选符号 */
.chip-on {
  background: var(--c-primary); color: #fff;
  border-color: var(--c-primary-deep);
}
.chip-on::before { content: '✓ '; font-weight: 500; }

/* 照片 */
.photo-group { margin-top: 32rpx; }
.photo-grid { display: flex; flex-wrap: wrap; gap: 20rpx; margin-top: 16rpx; }
.photo-cell { position: relative; width: 200rpx; height: 200rpx; }
.photo-img { width: 200rpx; height: 200rpx; border-radius: var(--radius-md); }
/* 删除角标 72rpx（原 40rpx≈20px，低于 WCAG 24px 下限） */
.photo-del {
  position: absolute; top: -16rpx; right: -16rpx;
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: var(--c-danger); border: 4rpx solid #fff;
  display: flex; align-items: center; justify-content: center;
  box-sizing: border-box;
}
.photo-del.del-hover { background: #9E2B20; transform: scale(1.08); }
.photo-del-x { color: #fff; font-size: 40rpx; line-height: 1; margin-top: -4rpx; }
.photo-add {
  width: 200rpx; height: 200rpx; border-radius: var(--radius-md);
  background: var(--c-primary-soft); border: 2rpx dashed #A9C4D8;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx;
  box-sizing: border-box;
}
.photo-add.btn-hover { background: #DCE9F2; }
.photo-add-plus { color: var(--c-primary); font-size: 56rpx; line-height: 1; }
.photo-add-text { color: var(--c-primary); font-size: var(--fs-xs); }

.preview-actions { display: flex; gap: 24rpx; margin-top: 48rpx; }
