/* pages/ocean/ocean.wxss — 空灵俯视插画海面
 * 一张轻量插画空海背景 + 复用顶视冰山 sprite + 顶视小鲸鱼。
 * 只动画 transform / opacity（GPU 合成，冰山多也不卡）；无运行时滤镜。
 * 弱网：CSS 渐变兜底先出，插画背景加载后淡入。场景色引用 app.wxss --sea-* token。
 * 触控 ≥88rpx；录音/发布 UI 沿用适老化定稿。
 */
.page { width: 100vw; height: 100vh; position: relative; overflow: hidden; }

/* ============ 场景层 ============ */
/* ============ 夜海主背景(用户定稿SVG·干净海) + 横向滚轴(无缩放) ============ */
.night-bg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.sea-area { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.sea-world { position: relative; }
/* 雪山=记忆：用户定稿SVG的真实云slab贴图（含纹理），按天数换红→蓝素材 */
.mtn { position: absolute; z-index: 2; pointer-events: auto; }
.mtn-img { display: block; width: 100%; }
.mtn-hover { opacity: .85; }
/* 小船=杭航：在雪山之间的海上飘，轻微左右摇（不压山） */
.boat-drift { position: absolute; z-index: 3; width: 150rpx; animation: boatdrift 7s ease-in-out infinite; pointer-events: auto; }
.boat-img { display: block; width: 100%; }
@keyframes boatdrift { 0%, 100% { transform: translateX(0) rotate(-1deg); } 50% { transform: translateX(12rpx) rotate(1deg); } }
.boat-drift.paused { animation-play-state: paused; }
.boat-hover { opacity: .85; }
/* 鲸鱼口中的气泡：生日引导+回答建议（随鲸鱼移动） */
.birth-bubble { position: absolute; left: 50%; bottom: 100%; transform: translateX(-85%); width: 400rpx; margin-bottom: 16rpx; background: var(--c-surface); border-radius: var(--r-card); padding: 20rpx 24rpx; box-shadow: 0 6rpx 18rpx rgba(2,2,31,.28); pointer-events: auto; }
.wb-q { display: block; font-size: var(--fs-lg); font-weight: 700; color: var(--c-text); line-height: 1.6; }
.wb-tail { position: absolute; left: 85%; bottom: -14rpx; transform: translateX(-50%); width: 0; height: 0; border-left: 14rpx solid transparent; border-right: 14rpx solid transparent; border-top: 16rpx solid rgba(253,252,249,.97); }


/* ============ 空态提示（深色胶囊白字，全渐变达标）============ */

/* ============ 首次问生日 ============ */

/* ============ 草稿找回（沿用定稿）============ */
.draft-bar { position: absolute; left: 24rpx; right: 24rpx; z-index: 21; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; background: #FFF6E5; border: 2rpx solid #E8C77A; border-radius: var(--radius-lg); padding: 20rpx 16rpx 20rpx 28rpx; }
.draft-text { color: #7A5410; font-size: var(--fs-sm); font-weight: 500; }
.draft-btn { min-width: 180rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; background: #96650F; color: #fff; border-radius: 999rpx; font-size: var(--fs-sm); font-weight: 500; }
.draft-btn.btn-hover { background: #7A5009; }

/* ============ 底部操作区（沿用定稿）============ */
.dock { position: absolute; left: 0; right: 0; bottom: 0; z-index: 20; display: flex; flex-direction: column; gap: 20rpx; padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 48rpx); }

/* 微信式细长条：单行居中，干净简洁；高度 96rpx 仍 ≥88rpx 触控下限 */
.record-btn { display: flex; align-items: center; justify-content: center; min-height: 96rpx; padding: 0 36rpx; background: var(--n-greet); border-radius: 999rpx; box-shadow: 0 6rpx 20rpx rgba(2,2,31,.35); }
.record-btn.record-hover { background: #F8C98F; transform: scale(0.98); }
.record-btn.record-on { background: #F8C98F; }
.record-btn.record-cancel { background: var(--c-danger); }
.record-btn.record-cancel .record-main, .record-btn.record-lock .record-main { color: #FFFCF6; }
.record-btn.record-lock { background: var(--c-accent); }
.record-main { color: var(--n-on-greet); font-size: var(--fs-body); font-weight: 700; letter-spacing: 0; line-height: 1.2; }

/* ============ 实时转写面板（微信式按住说话，0 延迟弹出）============ */
.live-mask { position: absolute; left: 0; right: 0; bottom: calc(env(safe-area-inset-bottom) + 160rpx); z-index: 35; display: flex; justify-content: center; padding: 0 32rpx; pointer-events: none; }
.live-card { width: 100%; background: rgba(253,252,249,0.97); border-radius: var(--radius-lg); padding: 28rpx 32rpx; box-shadow: 0 8px 24px rgba(0,0,0,.06); border: 2rpx solid var(--hairline); }
.live-card.live-cancel { background: rgba(247,232,228,0.97); border-color: rgba(179,64,47,0.25); }
.live-status { display: flex; align-items: center; gap: 14rpx; }
.live-dot { width: 20rpx; height: 20rpx; border-radius: 50%; background: var(--c-danger); }
.live-state { flex: 1; color: var(--c-text); font-size: var(--fs-md); font-weight: 600; }
.live-cancel .live-state { color: var(--c-danger); }
.live-timer { color: var(--c-text-2); font-size: var(--fs-sm); }
.live-asr { display: block; color: var(--c-text-2); font-size: var(--fs-xs); margin-top: 8rpx; }
.live-asr-warn { color: #8A5A15; }
.live-scroll { max-height: 360rpx; margin-top: 16rpx; }
.live-text { color: var(--c-text); font-size: var(--fs-xxl); line-height: 1.6; letter-spacing: 0; }
.live-countdown { display: flex; align-items: baseline; gap: 10rpx; margin-top: 12rpx; }
.live-countdown-num { color: var(--c-countdown); font-size: 64rpx; font-weight: 700; line-height: 1; }
.live-countdown-label { color: var(--c-countdown); font-size: var(--fs-sm); font-weight: 500; }
.live-hint { display: block; text-align: center; color: var(--c-text-2); font-size: var(--fs-xs); margin-top: 16rpx; letter-spacing: 0; }
.live-cancel .live-hint { color: var(--c-danger); }

/* ============ 发布卡片 ============ */
.preview-mask { position: absolute; left: 0; right: 0; top: 0; bottom: 0; z-index: 30; background: rgba(15,58,92,0.5); display: flex; align-items: flex-end; }
.preview-card { position: relative; width: 100%; background: var(--c-card); border-radius: var(--radius-xl) var(--radius-xl) 0 0; padding: 0 36rpx 40rpx; box-sizing: border-box; max-height: 88vh; overflow-y: auto; will-change: transform; }
.sheet-close-x { position: absolute; top: 12rpx; right: 12rpx; width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--c-soft); color: var(--c-text-2); font-size: 40rpx; line-height: 1; z-index: 2; }
.sheet-settle { transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
.sheet-grip { display: flex; justify-content: center; padding: 16rpx 0 20rpx; }
.sheet-grip-bar { width: 64rpx; height: 8rpx; border-radius: 4rpx; background: rgba(31, 27, 22, 0.16); }
.preview-text { width: 100%; min-height: 200rpx; font-size: var(--fs-lg); line-height: 1.7; color: var(--c-text); padding: 28rpx; box-sizing: border-box; background: var(--c-soft); border-radius: var(--radius-md); border: 2rpx solid #DCE9F2; }
/* 照片九宫格：微信式，灰底裸 + ，无解释文案 */
.photo-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.photo-cell { position: relative; width: 200rpx; height: 200rpx; }
.photo-img { width: 120rpx; height: 120rpx; border-radius: 12rpx; }
.photo-del { position: absolute; top: -16rpx; right: -16rpx; width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--c-danger); border: 4rpx solid #fff; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.photo-del.del-hover { background: #9E2B20; transform: scale(1.08); }
.photo-del-x { color: #fff; font-size: 40rpx; line-height: 1; margin-top: -4rpx; }
.photo-add { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: var(--c-surface-2); display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.photo-add.btn-hover { background: #E5E6E8; }
.photo-add-plus { color: var(--c-text-faint); font-size: 44rpx; line-height: 1; font-weight: 300; }
/* 微信式 meta cell：左标签 / 右值 / 箭头，点开 action sheet */
.time-hint { display: block; margin-top: 20rpx; font-size: var(--fs-sm); color: var(--c-text-2); }
.meta-cell { display: flex; align-items: center; min-height: 96rpx; padding: 0 8rpx; border-bottom: 2rpx solid rgba(9, 8, 86, 0.08); }
.meta-cell.cell-hover { background: var(--c-soft); }
.meta-label { flex: 0 0 160rpx; color: var(--c-text); font-size: var(--fs-md); }
.meta-value { flex: 1; text-align: right; color: var(--c-text-2); font-size: var(--fs-md); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.meta-arrow { color: #B0B8BF; font-size: 40rpx; margin-left: 12rpx; line-height: 1; }
.voice-check { display: flex; align-items: center; gap: 20rpx; min-height: 96rpx; margin-top: 20rpx; padding: 0 28rpx; background: var(--c-primary-soft); border-radius: var(--radius-md); }
.voice-check.btn-hover { background: #DCE9F2; }
.vc-btn { width: 56rpx; height: 56rpx; border-radius: 50%; background: var(--c-primary); position: relative; flex-shrink: 0; }
.vc-btn::after { content: ''; position: absolute; top: 50%; left: 54%; transform: translate(-50%,-50%); border-top: 12rpx solid transparent; border-bottom: 12rpx solid transparent; border-left: 18rpx solid #fff; }
.vc-on { background: var(--c-danger); }
.vc-on::after { border: none; width: 18rpx; height: 22rpx; background: #fff; top: 50%; left: 50%; transform: translate(-50%,-50%); border-radius: 3rpx; }
.vc-text { color: var(--c-primary); font-size: var(--fs-sm); font-weight: 500; }
.continue-hold { margin-top: 24rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; background: var(--c-card); border: 2rpx solid rgba(9,8,86,.28); border-radius: 999rpx; color: var(--c-primary); font-size: var(--fs-md); box-sizing: border-box; }
.preview-actions { display: flex; gap: 24rpx; margin-top: 24rpx; }



/* 右上角声音开关 */
/* 音量图标：正常=有声；加斜杠=静音（线性 icon，非 emoji） */

/* 新冰山红旗（5 分钟，回听提示） */

/* 提示脚手架 / 那年今日 / 润色回退 */
.today-bar { position: absolute; left: 24rpx; right: 140rpx; z-index: 21; background: rgba(253,252,249,.92); border: 2rpx solid var(--hairline); border-radius: var(--radius-md); padding: 14rpx 24rpx; color: var(--c-primary); font-size: var(--fs-sm); box-shadow: 0 1px 2px rgba(0,0,0,.05); }
.today-bar text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; }
.react-chip { background: rgba(247,232,228,.95); border-color: rgba(179,64,47,.25); color: var(--c-danger); }
.voice-review { position: absolute; left: 24rpx; right: 24rpx; bottom: calc(env(safe-area-inset-bottom) + 190rpx); z-index: 26; }
.vr-card { background: var(--c-card); border-radius: var(--radius-lg); padding: 28rpx; box-shadow: 0 8px 24px rgba(0,0,0,.06); display: flex; flex-direction: column; gap: 12rpx; }
.vr-title { font-size: var(--fs-md); font-weight: 600; color: var(--c-text); }
.vr-sub { font-size: var(--fs-sm); color: var(--c-text-2); }
.vr-play { align-self: flex-start; padding: 10rpx 28rpx; border-radius: 32rpx; background: var(--c-primary-soft); color: var(--c-primary); font-size: var(--fs-sm); }
.vr-btns { display: flex; gap: 16rpx; margin-top: 8rpx; }
.vr-like { flex: 1; min-height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-md); background: var(--c-primary); color: #fff; font-size: var(--fs-md); }
.vr-unlike { flex: 0 0 160rpx; min-height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: 40rpx; background: var(--c-soft); color: var(--c-text-2); font-size: var(--fs-md); }

/* ============ 减少动态效果：全停，静态显示 ============ */
@media (prefers-reduced-motion: reduce) {
  .boat-drift { animation: none !important; }
  .sheet-settle { transition: none !important; }
  .record-btn.record-hover { transform: none; }
}
/* ============ v2.0 C 门控 / D 字幕 / A9 状态 / A8 情绪 / A3 留白 ============ */
.live-ctrl { display: flex; gap: 12rpx; margin: 8rpx 0; pointer-events: auto; }
.live-ctrl-btn { padding: 6rpx 20rpx; border-radius: 24rpx; background: var(--c-soft); color: var(--c-text-2); font-size: var(--fs-xs); }
.live-ctrl-btn.on { background: var(--c-primary-soft); color: var(--c-primary); }
.live-text-big { font-size: 56rpx; line-height: 1.9; }
.refine-status { display: block; margin-top: 16rpx; color: var(--c-text-2); font-size: var(--fs-sm); }
.emotion-box { margin-top: 20rpx; padding: 24rpx; background: var(--c-soft); border-radius: var(--radius-md); }
.emotion-text { display: block; color: var(--c-text); font-size: var(--fs-md); line-height: 1.8; }
.emotion-rest { margin-top: 16rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; background: var(--c-card); border: 2rpx solid var(--hairline); border-radius: var(--radius-md); color: var(--c-primary); font-size: var(--fs-md); }

/* ============ 夜海 v2 覆盖：问候卡/录音钮/气泡 ============ */
.ocean-page { position: relative; width: 100vw; height: 100vh; overflow: hidden; background: var(--n-bg); }
.record-main { color: var(--n-on-greet); }
.live-hint { color: var(--c-text-soft); }
.birth-bubble { background: var(--c-surface); color: var(--c-text); }
.wb-q { color: var(--c-text); }
.wb-field { margin-top: 16rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center; background: var(--c-surface-2); border: 2rpx solid var(--c-line); border-radius: 24rpx; color: var(--c-accent); font-size: var(--fs-md); }
.wb-later { margin-top: 12rpx; text-align: center; color: var(--c-text-faint); font-size: var(--fs-xs); }
/* 帆船气泡：问候/提示由船"说"出 */
.boat-bubble { position: absolute; width: 300rpx; background: rgba(255,252,246,.94); border-radius: 28rpx; padding: 12rpx 20rpx; box-shadow: 0 4rpx 14rpx rgba(2,2,31,.25); pointer-events: auto; z-index: 25; }

.bb-text { display: block; font-size: var(--fs-sm); line-height: 1.6; color: var(--c-text); }
.bb-tail { position: absolute; bottom: -10rpx; width: 0; height: 0; border-left: 10rpx solid transparent; border-right: 10rpx solid transparent; border-top: 12rpx solid rgba(255,252,246,.94); }

.refine-status { font-size: var(--fs-xs); color: var(--c-text-soft); }
.refine-loading { display: flex; align-items: center; gap: 8rpx; }
.dots { display: flex; gap: 6rpx; align-items: center; }
.dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--c-text-soft); animation: dotjump 1s ease-in-out infinite; }
.dot:nth-child(2) { animation-delay: .18s; }
.dot:nth-child(3) { animation-delay: .36s; }
@keyframes dotjump { 0%, 100% { transform: translateY(0); opacity: .4; } 50% { transform: translateY(-6rpx); opacity: 1; } }
.top-hint { position: absolute; left: 48rpx; right: 48rpx; z-index: 30; text-align: center; background: rgba(255,252,246,.92); border-radius: 999rpx; padding: 10rpx 24rpx; box-shadow: 0 4rpx 14rpx rgba(2,2,31,.25); pointer-events: none; }
.top-hint text { font-size: var(--fs-sm); color: var(--c-text); line-height: 1.6; }
.sea-label { position: absolute; top: 24%; transform: translateX(-50%); font-size: var(--fs-sm); color: rgba(244,215,178,.75); letter-spacing: 2rpx; pointer-events: none; }
.record-btn.record-lock .record-main { color: #FFFCF6; }
.world-bg { position: absolute; left: 0; top: 0; z-index: 0; }
