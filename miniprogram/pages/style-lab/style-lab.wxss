/* v20 星空紫金·圆卡 */
.v20 { background: radial-gradient(circle at 30% 10%, #3B2A63, #140B2E 70%); color: #F5E9C8; font-family: 'Georgia', 'Songti SC', serif; }
.v20 .hero { height: 300rpx; border-radius: 50% 50% 24rpx 24rpx / 30% 30% 24rpx 24rpx; filter: hue-rotate(40deg) saturate(1.3); }
