/* 风格实验室：base + 20 版差异化风格（色彩/造型/排版/字体/展现形式均不同） */
.lab { min-height: 100vh; padding: 24rpx 28rpx 60rpx; box-sizing: border-box; background: #FBF7EF; color: #090856; font-family: -apple-system, 'PingFang SC', sans-serif; }
.hero { position: relative; height: 320rpx; border-radius: 24rpx; overflow: hidden; margin-bottom: 24rpx; }
.hero-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.mtn { position: absolute; bottom: 40rpx; width: 150rpx; height: 90rpx; border-radius: 46% 54% 0 0 / 88% 96% 0 0; }
.m1 { left: 60rpx; background: #F94830; }
.m2 { left: 300rpx; background: #0886E2; height: 120rpx; }
.boat { position: absolute; right: 70rpx; bottom: 30rpx; width: 90rpx; }
.hero-title { position: absolute; left: 28rpx; top: 24rpx; font-size: 44rpx; font-weight: 700; color: #F4D7B2; }
.greet { background: #FDDAAC; color: #090856; border-radius: 24rpx; padding: 28rpx; margin-bottom: 20rpx; }
.greet-t { font-size: 36rpx; font-weight: 700; }
.greet-b { font-size: 28rpx; margin-top: 8rpx; line-height: 1.7; }
.rec { min-height: 96rpx; display: flex; align-items: center; justify-content: center; background: #053091; color: #FDDAAC; border-radius: 999rpx; font-size: 32rpx; font-weight: 700; margin-bottom: 24rpx; }
.card { background: #FFFCF6; border-radius: 24rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 6rpx 18rpx rgba(9,8,86,.08); }
.card-t { font-size: 32rpx; font-weight: 700; margin-bottom: 16rpx; }
.node { display: flex; gap: 16rpx; align-items: baseline; padding: 10rpx 0; border-bottom: 1rpx solid rgba(9,8,86,.1); }
.node-d { font-size: 26rpx; color: #053091; font-weight: 700; }
.node-n { font-size: 30rpx; }
.btn-ghost { margin-top: 16rpx; min-height: 80rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid rgba(9,8,86,.2); border-radius: 999rpx; font-size: 28rpx; }
.row { display: flex; justify-content: space-between; align-items: center; font-size: 30rpx; padding: 8rpx 0; }
.sw { width: 88rpx; height: 48rpx; border-radius: 999rpx; background: #053091; position: relative; }
.knob { position: absolute; right: 6rpx; top: 6rpx; width: 36rpx; height: 36rpx; border-radius: 50%; background: #fff; }
.tags { display: flex; gap: 12rpx; margin-top: 16rpx; }
.tag { padding: 8rpx 20rpx; border-radius: 999rpx; background: rgba(5,48,145,.08); font-size: 24rpx; }
.tag.on { background: #053091; color: #FDDAAC; }
.foot { text-align: center; font-size: 24rpx; color: rgba(9,8,86,.45); margin-top: 12rpx; }

/* v1 现状·夜海暖白（基线） */
/* v2 晨雾纸感·衬线 */
.v2 { background: #F4F1EA; color: #2B2A26; font-family: 'Songti SC', 'SimSun', serif; }
.v2 .hero { height: 260rpx; border-radius: 8rpx; filter: sepia(.25) saturate(.7) brightness(1.1); }
.v2 .hero-title { font-family: 'Songti SC', serif; font-weight: 400; letter-spacing: 8rpx; color: #FFF8E7; }
.v2 .greet { background: #FFFDF6; color: #2B2A26; border-radius: 4rpx; border: 1rpx solid #D8D2C4; box-shadow: 4rpx 4rpx 0 #E4DED0; }
.v2 .rec { background: #2B2A26; color: #F4F1EA; border-radius: 4rpx; font-family: 'Songti SC', serif; letter-spacing: 6rpx; }
.v2 .card { background: #FFFDF6; border-radius: 4rpx; border: 1rpx solid #D8D2C4; box-shadow: none; }
.v2 .card-t { font-weight: 400; letter-spacing: 4rpx; border-bottom: 2rpx solid #2B2A26; padding-bottom: 8rpx; }
.v2 .btn-ghost { border-radius: 4rpx; border: 1rpx solid #2B2A26; }
.v2 .tag { border-radius: 2rpx; background: #EDE7DA; }
.v2 .tag.on { background: #8C2F26; color: #FFF8E7; }
.v2 .sw { background: #8C2F26; border-radius: 4rpx; }
.v2 .knob { border-radius: 2rpx; }
/* v3 墨黑终端·等宽 */
.v3 { background: #0B0F0C; color: #7CFC9A; font-family: 'Menlo', 'Courier New', monospace; }
.v3 .hero { height: 240rpx; border-radius: 0; border: 2rpx solid #7CFC9A; filter: grayscale(1) contrast(1.3) brightness(.7); }
.v3 .hero-title { font-family: 'Menlo', monospace; color: #7CFC9A; font-size: 32rpx; }
.v3 .hero-title::before { content: '> '; }
.v3 .greet { background: #0B0F0C; color: #7CFC9A; border: 2rpx solid #7CFC9A; border-radius: 0; }
.v3 .rec { background: #7CFC9A; color: #0B0F0C; border-radius: 0; font-family: 'Menlo', monospace; }
.v3 .card { background: #0B0F0C; border: 2rpx solid #3A5A40; border-radius: 0; box-shadow: none; }
.v3 .card-t::before { content: '$ '; }
.v3 .node { border-bottom: 1rpx dashed #3A5A40; }
.v3 .node-d { color: #7CFC9A; }
.v3 .btn-ghost { border-radius: 0; border: 2rpx solid #7CFC9A; color: #7CFC9A; }
.v3 .tag { border-radius: 0; background: #12241A; color: #7CFC9A; }
.v3 .tag.on { background: #7CFC9A; color: #0B0F0C; }
.v3 .sw { background: #7CFC9A; border-radius: 0; }
.v3 .knob { background: #0B0F0C; border-radius: 0; }
.v3 .foot { color: #3A5A40; }
/* v4 奶油童趣·圆 blob */
.v4 { background: #FFF3E0; color: #5D4037; font-family: 'Yuanti SC', 'YouYuan', sans-serif; }
.v4 .hero { height: 300rpx; border-radius: 60rpx 60rpx 60rpx 12rpx; }
.v4 .mtn { border-radius: 50% 50% 40% 60% / 70% 70% 30% 30%; }
.v4 .m1 { background: #FF7043; }
.v4 .m2 { background: #4FC3F7; }
.v4 .hero-title { color: #FFF; font-size: 48rpx; transform: rotate(-3deg); }
.v4 .greet { background: #FFCC80; border-radius: 48rpx 48rpx 48rpx 8rpx; transform: rotate(-1deg); }
.v4 .rec { background: #FF7043; color: #FFF; border-radius: 60rpx; font-size: 36rpx; box-shadow: 0 8rpx 0 #E64A19; }
.v4 .card { background: #FFF; border-radius: 40rpx; border: 4rpx solid #FFCC80; box-shadow: 0 8rpx 0 #FFE0B2; }
.v4 .btn-ghost { border-radius: 60rpx; border: 4rpx dashed #FF7043; color: #FF7043; }
.v4 .tag { border-radius: 40rpx; background: #FFE0B2; }
.v4 .tag.on { background: #4FC3F7; color: #FFF; }
.v4 .sw { background: #4FC3F7; }
/* v5 玻璃海·glassmorphism */
.v5 { background: linear-gradient(160deg, #04263F, #065A82 60%, #0A7EA4); color: #EAF6FF; }
.v5 .hero { height: 280rpx; border-radius: 32rpx; border: 1rpx solid rgba(255,255,255,.35); }
.v5 .greet { background: rgba(255,255,255,.14); color: #EAF6FF; border-radius: 32rpx; border: 1rpx solid rgba(255,255,255,.35); backdrop-filter: blur(20rpx); }
.v5 .rec { background: rgba(255,255,255,.2); color: #FFF; border: 1rpx solid rgba(255,255,255,.5); border-radius: 32rpx; backdrop-filter: blur(20rpx); }
.v5 .card { background: rgba(255,255,255,.12); border: 1rpx solid rgba(255,255,255,.3); border-radius: 32rpx; box-shadow: 0 8rpx 32rpx rgba(0,0,0,.2); backdrop-filter: blur(20rpx); }
.v5 .node { border-bottom: 1rpx solid rgba(255,255,255,.2); }
.v5 .node-d { color: #9BE0FF; }
.v5 .btn-ghost { border: 1rpx solid rgba(255,255,255,.5); border-radius: 32rpx; color: #EAF6FF; }
.v5 .tag { background: rgba(255,255,255,.15); color: #EAF6FF; }
.v5 .tag.on { background: #9BE0FF; color: #04263F; }
.v5 .sw { background: #9BE0FF; }
.v5 .knob { background: #04263F; }
.v5 .foot { color: rgba(234,246,255,.6); }
/* v6 报纸编辑·双栏线 */
.v6 { background: #EFE9DC; color: #1A1A1A; font-family: 'Songti SC', 'SimSun', serif; }
.v6 .hero { height: 220rpx; border-radius: 0; filter: grayscale(1) contrast(1.2); border-bottom: 6rpx double #1A1A1A; }
.v6 .hero-title { color: #1A1A1A; background: #EFE9DC; padding: 4rpx 16rpx; font-size: 52rpx; letter-spacing: 12rpx; }
.v6 .greet { background: transparent; color: #1A1A1A; border-radius: 0; border-top: 4rpx solid #1A1A1A; border-bottom: 1rpx solid #1A1A1A; padding: 20rpx 0; }
.v6 .greet-t { font-size: 44rpx; font-weight: 900; }
.v6 .rec { background: #1A1A1A; color: #EFE9DC; border-radius: 0; letter-spacing: 8rpx; }
.v6 .card { background: transparent; border-radius: 0; box-shadow: none; border-top: 4rpx solid #1A1A1A; padding: 20rpx 0; }
.v6 .card-t { font-size: 28rpx; letter-spacing: 6rpx; text-transform: uppercase; }
.v6 .node-d { color: #8C2F26; }
.v6 .btn-ghost { border-radius: 0; border: 2rpx solid #1A1A1A; }
.v6 .tag { border-radius: 0; background: transparent; border: 1rpx solid #1A1A1A; }
.v6 .tag.on { background: #8C2F26; color: #EFE9DC; border-color: #8C2F26; }
.v6 .sw { background: #1A1A1A; border-radius: 0; }
.v6 .knob { border-radius: 0; background: #EFE9DC; }
/* v7 霓虹赛博·切角 */
.v7 { background: #12041F; color: #0FF0FC; font-family: 'Arial Narrow', 'PingFang SC', sans-serif; }
.v7 .hero { height: 280rpx; border-radius: 0; clip-path: polygon(0 0, 100% 0, 100% 82%, 92% 100%, 0 100%); filter: hue-rotate(120deg) saturate(2); }
.v7 .hero-title { color: #FF2ED2; text-shadow: 0 0 12rpx #FF2ED2; font-size: 48rpx; letter-spacing: 4rpx; }
.v7 .greet { background: #1B0B33; color: #0FF0FC; border-radius: 0; border: 2rpx solid #0FF0FC; box-shadow: 0 0 16rpx rgba(15,240,252,.5); clip-path: polygon(0 0, 100% 0, 100% 100%, 6% 100%, 0 86%); }
.v7 .rec { background: #FF2ED2; color: #12041F; border-radius: 0; clip-path: polygon(4% 0, 100% 0, 96% 100%, 0 100%); font-weight: 900; }
.v7 .card { background: #1B0B33; border: 2rpx solid #FF2ED2; border-radius: 0; box-shadow: 0 0 16rpx rgba(255,46,210,.4); }
.v7 .node { border-bottom: 1rpx dashed #0FF0FC; }
.v7 .node-d { color: #FF2ED2; }
.v7 .btn-ghost { border: 2rpx solid #0FF0FC; border-radius: 0; color: #0FF0FC; }
.v7 .tag { border-radius: 0; background: #241040; color: #0FF0FC; }
.v7 .tag.on { background: #0FF0FC; color: #12041F; }
.v7 .sw { background: #FF2ED2; border-radius: 0; }
.v7 .knob { background: #12041F; border-radius: 0; }
.v7 .foot { color: #FF2ED2; }
/* v8 莫兰迪·灰粉鼠尾草 */
.v8 { background: #D8D3CD; color: #4A4A48; font-family: 'PingFang SC', sans-serif; }
.v8 .hero { height: 240rpx; border-radius: 16rpx; filter: saturate(.35) brightness(1.15); }
.v8 .m1 { background: #C89F9C; }
.v8 .m2 { background: #9BA88D; }
.v8 .hero-title { color: #F2EFEA; font-weight: 300; letter-spacing: 10rpx; font-size: 36rpx; }
.v8 .greet { background: #C89F9C; color: #FFF; border-radius: 16rpx; }
.v8 .rec { background: #9BA88D; color: #FFF; border-radius: 16rpx; font-weight: 400; letter-spacing: 4rpx; }
.v8 .card { background: #E7E3DD; border-radius: 16rpx; box-shadow: none; border: 1rpx solid #C4BFB7; }
.v8 .card-t { font-weight: 400; letter-spacing: 4rpx; color: #6B6B68; }
.v8 .node-d { color: #8A6F6C; }
.v8 .btn-ghost { border-radius: 16rpx; border: 1rpx solid #9BA88D; color: #6B7A5E; }
.v8 .tag { background: #CDC8C0; color: #4A4A48; }
.v8 .tag.on { background: #8A6F6C; color: #FFF; }
.v8 .sw { background: #9BA88D; }
/* v9 像素复古·8bit */
.v9 { background: #202020; color: #F8F8F8; font-family: 'Menlo', monospace; image-rendering: pixelated; }
.v9 .hero { height: 240rpx; border-radius: 0; border: 8rpx solid #F8F8F8; box-shadow: 8rpx 8rpx 0 #000; filter: contrast(1.4) saturate(1.6); }
.v9 .hero-title { font-size: 32rpx; color: #FFD400; text-shadow: 4rpx 4rpx 0 #000; }
.v9 .greet { background: #303030; color: #F8F8F8; border-radius: 0; border: 4rpx solid #F8F8F8; box-shadow: 6rpx 6rpx 0 #000; }
.v9 .rec { background: #E43B44; color: #FFF; border-radius: 0; border: 4rpx solid #F8F8F8; box-shadow: 6rpx 6rpx 0 #000; }
.v9 .card { background: #303030; border-radius: 0; border: 4rpx solid #F8F8F8; box-shadow: 6rpx 6rpx 0 #000; }
.v9 .node { border-bottom: 4rpx dotted #505050; }
.v9 .node-d { color: #FFD400; }
.v9 .btn-ghost { border-radius: 0; border: 4rpx solid #FFD400; color: #FFD400; }
.v9 .tag { border-radius: 0; background: #404040; }
.v9 .tag.on { background: #FFD400; color: #202020; }
.v9 .sw { background: #E43B44; border-radius: 0; }
.v9 .knob { border-radius: 0; }
/* v10 水彩手绘·楷体 */
.v10 { background: #F7F3EC; color: #3E4A3D; font-family: 'Kaiti SC', 'KaiTi', cursive; }
.v10 .hero { height: 280rpx; border-radius: 40% 60% 55% 45% / 50% 45% 55% 50%; filter: saturate(.8) brightness(1.1) blur(1rpx); }
.v10 .hero-title { font-family: 'Kaiti SC', cursive; font-size: 52rpx; color: #FFF; transform: rotate(-4deg); }
.v10 .greet { background: #EAF930; background: #EAF930; border-radius: 30rpx 50rpx 40rpx 55rpx; transform: rotate(.6deg); background: #DDE8C9; }
.v10 .rec { background: #7A9B76; color: #FFF; border-radius: 50rpx 40rpx 55rpx 35rpx; font-family: 'Kaiti SC', cursive; font-size: 36rpx; }
.v10 .card { background: #FFF; border-radius: 45rpx 35rpx 50rpx 40rpx; border: 2rpx dashed #7A9B76; box-shadow: none; }
.v10 .card-t { font-family: 'Kaiti SC', cursive; font-size: 36rpx; }
.v10 .node { border-bottom: 2rpx dotted #B5C9A8; }
.v10 .node-d { color: #C77B4F; }
.v10 .btn-ghost { border-radius: 40rpx; border: 2rpx dashed #C77B4F; color: #C77B4F; }
.v10 .tag { border-radius: 30rpx; background: #E4EDD6; }
.v10 .tag.on { background: #C77B4F; color: #FFF; }
.v10 .sw { background: #7A9B76; }
/* v11 极简白·大留白 */
.v11 { background: #FFFFFF; color: #111; font-family: 'Helvetica Neue', 'PingFang SC', sans-serif; padding: 48rpx 40rpx; }
.v11 .hero { height: 200rpx; border-radius: 0; filter: grayscale(1) brightness(1.3); opacity: .85; }
.v11 .hero-title { color: #111; font-weight: 200; font-size: 56rpx; letter-spacing: 16rpx; }
.v11 .greet { background: #FFF; color: #111; border-radius: 0; padding: 32rpx 0; border-bottom: 1rpx solid #111; }
.v11 .greet-t { font-weight: 200; font-size: 44rpx; }
.v11 .greet-b { color: #666; }
.v11 .rec { background: #111; color: #FFF; border-radius: 0; min-height: 104rpx; font-weight: 400; letter-spacing: 12rpx; }
.v11 .card { background: #FFF; border-radius: 0; box-shadow: none; border-bottom: 1rpx solid #DDD; padding: 32rpx 0; }
.v11 .card-t { font-weight: 200; font-size: 28rpx; letter-spacing: 8rpx; color: #999; }
.v11 .node-d { color: #111; font-weight: 400; }
.v11 .btn-ghost { border-radius: 0; border: 1rpx solid #111; }
.v11 .tag { border-radius: 0; background: #F2F2F2; }
.v11 .tag.on { background: #111; color: #FFF; }
.v11 .sw { background: #111; }
/* v12 深海渐变·波浪分隔 */
.v12 { background: linear-gradient(180deg, #012A36, #01495C 50%, #026873); color: #DFF6F9; }
.v12 .hero { height: 300rpx; border-radius: 0 0 50% 50% / 0 0 24rpx 24rpx; }
.v12 .greet { background: #DFF6F9; color: #012A36; border-radius: 40rpx 40rpx 40rpx 4rpx; }
.v12 .rec { background: #026873; color: #DFF6F9; border: 2rpx solid #DFF6F9; border-radius: 40rpx; }
.v12 .card { background: rgba(223,246,249,.1); border-radius: 40rpx; border: 1rpx solid rgba(223,246,249,.3); box-shadow: none; }
.v12 .node { border-bottom: 1rpx solid rgba(223,246,249,.25); }
.v12 .node-d { color: #7FE3D2; }
.v12 .btn-ghost { border: 1rpx solid #7FE3D2; color: #7FE3D2; border-radius: 40rpx; }
.v12 .tag { background: rgba(223,246,249,.15); color: #DFF6F9; }
.v12 .tag.on { background: #7FE3D2; color: #012A36; }
.v12 .sw { background: #7FE3D2; }
.v12 .knob { background: #012A36; }
.v12 .foot { color: rgba(223,246,249,.6); }
/* v13 暖橙日落 */
.v13 { background: linear-gradient(180deg, #FFB88C, #FF8A65 55%, #E64A19); color: #3E2723; }
.v13 .hero { height: 280rpx; border-radius: 32rpx; filter: sepia(.3) saturate(1.4) hue-rotate(-15deg); }
.v13 .hero-title { color: #FFF3E0; font-size: 48rpx; font-weight: 900; }
.v13 .greet { background: #FFF3E0; color: #3E2723; border-radius: 32rpx; }
.v13 .rec { background: #3E2723; color: #FFB88C; border-radius: 32rpx; font-weight: 900; }
.v13 .card { background: rgba(255,243,224,.92); border-radius: 32rpx; box-shadow: 0 10rpx 24rpx rgba(62,39,35,.25); }
.v13 .node-d { color: #E64A19; }
.v13 .btn-ghost { border: 2rpx solid #3E2723; border-radius: 32rpx; color: #3E2723; }
.v13 .tag { background: #FFCCBC; }
.v13 .tag.on { background: #E64A19; color: #FFF3E0; }
.v13 .sw { background: #3E2723; }
.v13 .knob { background: #FFB88C; }
/* v14 薄荷医疗·干净圆角 */
.v14 { background: #F0FBF7; color: #14532D; font-family: 'PingFang SC', sans-serif; }
.v14 .hero { height: 240rpx; border-radius: 20rpx; filter: hue-rotate(90deg) saturate(.6) brightness(1.15); }
.v14 .m1 { background: #34D399; }
.v14 .m2 { background: #10B981; }
.v14 .hero-title { color: #FFF; font-size: 36rpx; font-weight: 600; }
.v14 .greet { background: #D1FAE5; color: #14532D; border-radius: 20rpx; }
.v14 .rec { background: #10B981; color: #FFF; border-radius: 20rpx; font-weight: 600; }
.v14 .card { background: #FFF; border-radius: 20rpx; border: 1rpx solid #A7F3D0; box-shadow: 0 4rpx 12rpx rgba(20,83,45,.06); }
.v14 .node { border-bottom: 1rpx solid #D1FAE5; }
.v14 .node-d { color: #059669; }
.v14 .btn-ghost { border: 1rpx solid #10B981; color: #059669; border-radius: 20rpx; }
.v14 .tag { background: #D1FAE5; color: #14532D; border-radius: 12rpx; }
.v14 .tag.on { background: #10B981; color: #FFF; }
.v14 .sw { background: #10B981; }
/* v15 紫罗兰夜·金饰衬线 */
.v15 { background: #1B1035; color: #E9D5FF; font-family: 'Georgia', 'Songti SC', serif; }
.v15 .hero { height: 280rpx; border-radius: 24rpx 24rpx 0 0; filter: hue-rotate(60deg) saturate(1.2); border-bottom: 4rpx double #D4AF37; }
.v15 .hero-title { color: #D4AF37; font-family: 'Georgia', serif; font-size: 48rpx; letter-spacing: 6rpx; }
.v15 .greet { background: #2A1B4D; color: #E9D5FF; border-radius: 0; border: 1rpx solid #D4AF37; }
.v15 .greet-t { color: #D4AF37; font-family: 'Georgia', serif; }
.v15 .rec { background: #D4AF37; color: #1B1035; border-radius: 0; font-family: 'Georgia', serif; letter-spacing: 6rpx; }
.v15 .card { background: #2A1B4D; border-radius: 0; border: 1rpx solid #6D28D9; box-shadow: none; }
.v15 .card-t { color: #D4AF37; font-family: 'Georgia', serif; letter-spacing: 4rpx; }
.v15 .node { border-bottom: 1rpx solid #6D28D9; }
.v15 .node-d { color: #D4AF37; }
.v15 .btn-ghost { border: 1rpx solid #D4AF37; color: #D4AF37; border-radius: 0; }
.v15 .tag { background: #3B2A63; color: #E9D5FF; border-radius: 0; }
.v15 .tag.on { background: #D4AF37; color: #1B1035; }
.v15 .sw { background: #D4AF37; border-radius: 0; }
.v15 .knob { background: #1B1035; border-radius: 0; }
.v15 .foot { color: #D4AF37; }
/* v16 牛皮纸档案·打字机 */
.v16 { background: #D9C7A7; color: #3B2F2F; font-family: 'Courier New', monospace; }
.v16 .hero { height: 240rpx; border-radius: 4rpx; filter: sepia(.6) contrast(.95); border: 8rpx solid #FFF; box-shadow: 0 6rpx 16rpx rgba(59,47,47,.3); transform: rotate(-1deg); }
.v16 .hero-title { color: #3B2F2F; background: #D9C7A7; font-size: 32rpx; padding: 2rpx 12rpx; }
.v16 .greet { background: #EFE3CB; color: #3B2F2F; border-radius: 4rpx; border: 2rpx dashed #8B7355; }
.v16 .rec { background: #8B2F26; color: #EFE3CB; border-radius: 4rpx; font-family: 'Courier New', monospace; }
.v16 .card { background: #EFE3CB; border-radius: 4rpx; box-shadow: 4rpx 4rpx 0 #B5A88C; }
.v16 .card-t { text-transform: uppercase; letter-spacing: 4rpx; border-bottom: 2rpx solid #3B2F2F; }
.v16 .node-d { color: #8B2F26; }
.v16 .btn-ghost { border: 2rpx dashed #8B7355; border-radius: 4rpx; }
.v16 .tag { border-radius: 4rpx; background: #C9B896; }
.v16 .tag.on { background: #8B2F26; color: #EFE3CB; }
.v16 .sw { background: #8B2F26; border-radius: 4rpx; }
.v16 .knob { border-radius: 2rpx; }
/* v17 冰蓝玻璃· crisp */
.v17 { background: #EAF4FB; color: #0F3057; font-family: 'Helvetica Neue', 'PingFang SC', sans-serif; }
.v17 .hero { height: 260rpx; border-radius: 8rpx; filter: hue-rotate(160deg) saturate(.5) brightness(1.25); }
.v17 .hero-title { color: #0F3057; font-weight: 300; letter-spacing: 8rpx; font-size: 36rpx; }
.v17 .greet { background: #FFF; color: #0F3057; border-radius: 8rpx; border-left: 8rpx solid #2E86AB; }
.v17 .rec { background: #2E86AB; color: #FFF; border-radius: 8rpx; font-weight: 500; }
.v17 .card { background: #FFF; border-radius: 8rpx; box-shadow: 0 2rpx 8rpx rgba(15,48,87,.08); border: 1rpx solid #CFE3F2; }
.v17 .card-t { font-weight: 500; color: #2E86AB; }
.v17 .node { border-bottom: 1rpx solid #E3EEF7; }
.v17 .node-d { color: #2E86AB; }
.v17 .btn-ghost { border: 1rpx solid #2E86AB; color: #2E86AB; border-radius: 8rpx; }
.v17 .tag { border-radius: 8rpx; background: #E3EEF7; }
.v17 .tag.on { background: #2E86AB; color: #FFF; }
.v17 .sw { background: #2E86AB; }
/* v18 红黑构成·斜切 */
.v18 { background: #F2E8DC; color: #111; font-family: 'Arial Narrow', 'PingFang SC', sans-serif; }
.v18 .hero { height: 260rpx; border-radius: 0; clip-path: polygon(0 0, 100% 6%, 100% 100%, 0 94%); filter: contrast(1.3) saturate(1.5); }
.v18 .hero-title { color: #F2E8DC; background: #D62828; font-size: 52rpx; font-weight: 900; transform: skewX(-8deg); padding: 0 16rpx; }
.v18 .greet { background: #111; color: #F2E8DC; border-radius: 0; transform: skewX(-2deg); }
.v18 .rec { background: #D62828; color: #F2E8DC; border-radius: 0; font-weight: 900; font-size: 36rpx; transform: skewX(-6deg); }
.v18 .card { background: #FFF; border-radius: 0; border: 4rpx solid #111; box-shadow: 10rpx 10rpx 0 #D62828; }
.v18 .card-t { font-weight: 900; text-transform: uppercase; }
.v18 .node-d { color: #D62828; font-weight: 900; }
.v18 .btn-ghost { border: 4rpx solid #111; border-radius: 0; font-weight: 700; }
.v18 .tag { border-radius: 0; background: #F2E8DC; border: 2rpx solid #111; }
.v18 .tag.on { background: #D62828; color: #F2E8DC; border-color: #D62828; }
.v18 .sw { background: #D62828; border-radius: 0; }
.v18 .knob { border-radius: 0; background: #F2E8DC; }
