<!--pages/timeline/timeline.wxml — 时间轴
    适老化要点：
    - 每条回忆卡片整行可点，高度 ≥120rpx，右侧有明确箭头提示"可以点"
    - 标题 36rpx，元信息 30rpx（全站字号下限）
    - 年份徽章放大，当前年份高亮
    - 记不清年份的回忆单独分组，文案温和不指责
    - 空态给出明确的下一步动作按钮
-->
<view class="page wash-bg">
  <view class="tl-head">
    <text class="tl-title">人生的时间轴</text>
    <text class="tl-sub">一共 {{total}} 座冰山，点一下就能看</text>
  </view>

  <scroll-view scroll-y class="tl-scroll" enhanced show-scrollbar="{{false}}">
    <view class="tl-year" wx:for="{{years}}" wx:key="year" wx:for-item="y">
      <view class="year-badge">
        <text>{{y.year}}</text>
      </view>
      <view class="year-line">
        <view class="tl-item" wx:for="{{y.items}}" wx:key="id"
          hover-class="item-hover" hover-stay-time="80"
          data-id="{{item.id}}" bindtap="goDetail">
          <view class="item-dot">
            <image wx:if="{{item.icon}}" class="item-icon" src="/images/pixel/{{item.icon}}.png" mode="aspectFit" />
          </view>
          <view class="item-card enter" style="animation-delay:{{(index > 5 ? 5 : index) * 50}}ms">
            <text class="item-title">{{item.title}}</text>
            <text class="item-meta">{{item.label}}{{item.label && item.zoneName ? ' · ' : ''}}{{item.zoneName}}之海</text>
          </view>
          <view class="item-arrow">›</view>
        </view>
      </view>
    </view>

    <view wx:if="{{!years.length}}" class="tl-empty">
      <image class="empty-img" src="/images/misc/empty-state.png" mode="aspectFit" />
      <text class="empty-title">还没有冰山</text>
      <text class="empty-sub">回到海洋，按住下面的蓝色按钮说说话</text>
      <text class="empty-sub">说过的话就会变成一座冰山</text>
      <button class="btn-primary empty-btn" hover-class="btn-hover" hover-stay-time="80"
        bindtap="goOcean">回到海洋去说话</button>
    </view>
  </scroll-view>
  <view class="s-tabbar">
    <view class="s-tab " data-t="home" bindtap="onTab">摘要</view>
    <view class="s-tab " data-t="ocean" bindtap="onTab">海洋</view>
    <view class="s-tab active" data-t="timeline" bindtap="onTab">时间轴</view>
    <view class="s-tab " data-t="me" bindtap="onTab">杭航</view>
  </view>
</view>
<privacy-popup />
