/* pages/timeline/timeline.wxss */
.page { height: 100vh; display: flex; flex-direction: column; }
.tl-head { padding: 32rpx 36rpx 16rpx; }
.tl-title { font-size: 40rpx; font-weight: 500; color: #2C3E50; }
.tl-sub { display: block; font-size: 26rpx; color: #7A93A6; margin-top: 8rpx; }

.tl-scroll { flex: 1; padding: 0 36rpx; box-sizing: border-box; }
.tl-year { display: flex; margin-bottom: 24rpx; }
.year-badge {
  width: 120rpx; flex-shrink: 0; text-align: center;
  color: #4A9BD1; font-size: 34rpx; font-weight: 500;
  background: #F2F9FD; border-radius: 20rpx; padding: 12rpx 0; height: fit-content;
}
.year-line { flex: 1; padding-left: 28rpx; border-left: 4rpx dashed #BFE0F2; margin-left: -2rpx; }
.tl-item { display: flex; align-items: center; gap: 20rpx; margin: 20rpx 0 20rpx -18rpx; }
.item-dot {
  width: 40rpx; height: 40rpx; border-radius: 50%; background: #E1F0F9;
  border: 6rpx solid #fff; display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; box-sizing: content-box;
}
.dot-plain { background: #BFE0F2; }
.item-icon { width: 28rpx; height: 36rpx; }
.item-card { flex: 1; background: #fff; border-radius: 24rpx; padding: 22rpx 28rpx; }
.item-title { font-size: 32rpx; color: #2C3E50; }
.item-meta { display: block; font-size: 24rpx; color: #7A93A6; margin-top: 6rpx; }

.tl-empty { display: flex; flex-direction: column; align-items: center; padding-top: 120rpx; }
.empty-img { width: 320rpx; height: 240rpx; margin-bottom: 24rpx; }
