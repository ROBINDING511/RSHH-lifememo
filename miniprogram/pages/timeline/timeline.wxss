/* pages/timeline/timeline.wxss — 时间轴（温暖水彩 · 适老化） */
.page { height: 100vh; display: flex; flex-direction: column; }
.tl-head { padding: 32rpx 36rpx 20rpx; }
.tl-title { display: block; font-size: var(--fs-xl); font-weight: 600; color: var(--c-text); }
.tl-sub { display: block; font-size: var(--fs-sm); color: var(--c-text-2); margin-top: 10rpx; }

.tl-scroll { flex: 1; padding: 0 36rpx 60rpx; box-sizing: border-box; }
.tl-year { display: flex; margin-bottom: 28rpx; }

.year-badge {
  width: 168rpx; flex-shrink: 0; text-align: center;
  color: #fff; background: var(--c-primary);
  font-size: var(--fs-md); font-weight: 500;
  border-radius: var(--radius-md); padding: 16rpx 0; height: fit-content;
  box-shadow: 0 4rpx 14rpx rgba(9, 8, 86, 0.18);
}
.year-line { flex: 1; padding-left: 32rpx; border-left: 4rpx dashed #9FC3C6; margin-left: -2rpx; }

.tl-item { display: flex; align-items: center; gap: 20rpx; margin: 20rpx 0 20rpx -22rpx; }
.tl-item.item-hover .item-card { background: var(--c-primary-soft); transform: scale(0.99); }

.item-dot {
  width: 52rpx; height: 52rpx; border-radius: 50%;
  background: var(--c-primary-soft); border: 6rpx solid var(--c-card);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; box-sizing: content-box;
}
.item-icon { width: 32rpx; height: 40rpx; }

.item-card {
  flex: 1; min-width: 0;
  background: var(--c-card); border-radius: var(--radius-md);
  padding: 26rpx 28rpx;
  border: 2rpx solid rgba(9, 8, 86, 0.06);
  box-shadow: 0 4rpx 16rpx rgba(9, 8, 86, 0.08);
}
.item-title { display: block; font-size: var(--fs-md); font-weight: 500; color: var(--c-text); line-height: 1.55; }
.item-meta { display: block; font-size: var(--fs-xs); color: var(--c-text-2); margin-top: 8rpx; }
.item-arrow { font-size: 48rpx; color: var(--c-primary); line-height: 1; flex-shrink: 0; padding: 0 8rpx 0 0; }

/* ============ 空态 ============ */
.tl-empty { display: flex; flex-direction: column; align-items: center; padding: 100rpx 40rpx 60rpx; }
.empty-img { width: 320rpx; height: 240rpx; margin-bottom: 32rpx; }
.empty-title { font-size: var(--fs-xl); color: var(--c-text); font-weight: 500; }
.empty-sub { font-size: var(--fs-sm); color: var(--c-text-2); margin-top: 12rpx; text-align: center; line-height: 1.7; }
.empty-btn { width: 100%; margin-top: 48rpx; }