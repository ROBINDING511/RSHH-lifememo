/* pages/recycle/recycle.wxss */
.page { height: 100vh; display: flex; flex-direction: column; background: linear-gradient(180deg, #E8F4FB 0%, #F7FBFE 40%); }
.head { padding: 32rpx 36rpx 16rpx; }
.title { font-size: 40rpx; font-weight: 500; color: #2C3E50; }
.sub { display: block; font-size: 26rpx; color: #7A93A6; margin-top: 8rpx; }

.empty { display: flex; flex-direction: column; align-items: center; padding-top: 160rpx; }
.empty-img { width: 260rpx; height: 180rpx; opacity: 0.6; margin-bottom: 24rpx; }

.list { flex: 1; padding: 0 36rpx 40rpx; box-sizing: border-box; }
.cloud-card {
  display: flex; align-items: center; gap: 24rpx;
  background: #fff; border-radius: 32rpx; padding: 28rpx;
  margin-bottom: 24rpx; box-shadow: 0 6rpx 24rpx rgba(74,155,209,0.10);
}
.cloud-img { width: 110rpx; height: 80rpx; flex-shrink: 0; }
.cloud-info { flex: 1; min-width: 0; }
.cloud-title { font-size: 32rpx; color: #2C3E50; }
.cloud-meta { display: block; font-size: 24rpx; color: #7A93A6; margin-top: 6rpx; }
.rain-btn {
  background: #4A9BD1; color: #fff; font-size: 26rpx;
  border-radius: 32rpx; padding: 0 28rpx; height: 68rpx; line-height: 68rpx;
  flex-shrink: 0; margin: 0;
}
.rain-btn::after { border: none; }

.raining { animation: rain-shake 0.4s ease infinite; }
@keyframes rain-shake {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(10rpx); }
}
