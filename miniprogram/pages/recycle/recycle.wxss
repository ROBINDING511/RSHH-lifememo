/* pages/recycle/recycle.wxss — 云朵回收站（温暖水彩 · 适老化） */
.page { height: 100vh; display: flex; flex-direction: column; }
.head { padding: 32rpx 36rpx 20rpx; }
.title { display: block; font-size: var(--fs-xl); font-weight: 600; color: var(--c-text); }
.sub { display: block; font-size: var(--fs-sm); color: var(--c-text-2); margin-top: 10rpx; }

/* ============ 空态 ============ */
.empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 48rpx 60rpx; }
.empty-img { width: 280rpx; height: 200rpx; margin-bottom: 32rpx; }
.empty-title { font-size: var(--fs-xl); color: var(--c-text); font-weight: 500; }
.empty-sub { font-size: var(--fs-sm); color: var(--c-text-2); margin-top: 12rpx; text-align: center; line-height: 1.7; }
.empty-btn { width: 100%; margin-top: 56rpx; }

/* ============ 列表 ============ */
.list { flex: 1; padding: 0 36rpx 60rpx; box-sizing: border-box; }
.cloud-card {
  display: flex; flex-direction: column; align-items: stretch; gap: 20rpx;
  background: var(--c-card); border-radius: var(--radius-lg);
  padding: 32rpx 28rpx; margin-bottom: 24rpx;
  border: 2rpx solid rgba(31, 100, 120, 0.06);
  box-shadow: 0 6rpx 24rpx rgba(31, 100, 120, 0.10);
}
.cloud-top { display: flex; align-items: center; gap: 20rpx; }
.cloud-img { width: 120rpx; height: 88rpx; flex-shrink: 0; }
.cloud-info { flex: 1; min-width: 0; }
.cloud-title {
  display: block; font-size: var(--fs-md); font-weight: 500; color: var(--c-text);
  line-height: 1.5; overflow: hidden; text-overflow: ellipsis;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.cloud-meta { display: block; font-size: var(--fs-xs); color: var(--c-text-2); margin-top: 8rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.rain-btn {
  width: 100%; margin: 0;
  min-height: 88rpx; line-height: 88rpx;
  background: var(--c-primary); color: #fff;
  font-size: var(--fs-sm); font-weight: 500;
  border-radius: var(--radius-md); padding: 0 32rpx;
}
.rain-btn::after { border: none; }
.rain-btn.rain-hover { background: var(--c-primary-deep); transform: scale(0.97); }
.rain-btn[disabled] { background: #9FC3C6; color: #fff; }

.list-tip { padding: 8rpx 8rpx 24rpx; text-align: center; }
.list-tip text { font-size: var(--fs-xs); color: var(--c-text-2); }

/* ============ 恢复中动效 ============ */
.raining { animation: rain-shake 0.6s ease-in-out infinite; }
@keyframes rain-shake { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(8rpx); } }
@media (prefers-reduced-motion: reduce) { .raining { animation: none; } }