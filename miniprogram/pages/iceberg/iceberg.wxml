<!--pages/iceberg/iceberg.wxml — 冰山详情
    适老化要点：
    - 正文 ≥40rpx，行高 1.9，段间距拉开，长文也好读
    - 播放原声按钮放大到 120rpx，配明确文字与播放态
    - 所有按钮 ≥104rpx 高；删除入口写"化成云"并说明可找回
    - 标记选择用大图标 + 文字，选中态不只靠颜色
-->
<view class="page wash-bg" wx:if="{{b}}">
  <view class="berg-head card">
    <view class="berg-head-row">
      <image class="berg-icon" wx:if="{{iconFile}}" src="{{iconFile}}" mode="aspectFit" />
      <view class="berg-titles">
        <text class="berg-title">{{b.title}}</text>
        <text class="berg-meta">{{b.memoryTime}} · {{b.zoneName}}之海</text>
      </view>
    </view>
  </view>

  <view class="berg-body card">
    <text class="berg-text" selectable="{{true}}">{{b.text}}</text>

    <view class="voice-row" wx:if="{{b.audioFileID}}"
      hover-class="voice-hover" hover-stay-time="80" bindtap="playVoice">
      <view class="voice-btn {{playing ? 'voice-on' : ''}}">
        <view class="voice-glyph {{playing ? 'voice-glyph-on' : ''}}"></view>
      </view>
      <view class="voice-label">
        <text class="voice-tip">{{playing ? '正在播放，点这里停' : '听听当时的声音'}}</text>
        <text class="voice-sub" wx:if="{{!playing}}">您当时说这段话的录音</text>
      </view>
    </view>
  </view>

  <view class="berg-photos card" wx:if="{{b.photos.length}}">
    <text class="photos-label">照片（点一下看大图）</text>
    <view class="photos-grid">
      <view class="photo-cell" wx:for="{{b.photos}}" wx:key="*this">
        <image class="photo-img" src="{{item}}" mode="aspectFill"
          data-src="{{item}}" bindtap="previewPhoto" />
      </view>
    </view>
  </view>

  <view class="continue-entry" hover-class="btn-hover" hover-stay-time="80" bindtap="continueRecord">
    继续说 / 补录这段
  </view>

  <view class="actions safe-bottom">
    <button class="btn-ghost flex1" hover-class="btn-hover" hover-stay-time="80"
      bindtap="onShowIconMenu">放个标记</button>
    <button class="btn-ghost btn-danger-ghost flex1" hover-class="btn-hover" hover-stay-time="80"
      bindtap="meltIceberg">化成云</button>
  </view>

  <!-- 标记选择 -->
  <view class="icon-mask" wx:if="{{showIconMenu}}" bindtap="closeIconMenu">
    <view class="icon-sheet safe-bottom" catchtap="">
      <text class="sheet-title">选一个小标记，放上冰山</text>
      <text class="sheet-sub">标记是给自己看的记号，选哪个都行，之后还能换</text>
      <view class="icon-grid">
        <view class="icon-cell {{b.icon === item.key ? 'icon-cell-on' : ''}}"
          wx:for="{{icons}}" wx:key="key"
          hover-class="icon-hover" hover-stay-time="80"
          data-i="{{index}}" bindtap="pickIcon">
          <image class="icon-img" src="{{item.file}}" mode="aspectFit" />
          <text class="icon-name">{{item.name}}</text>
          <view class="icon-check" wx:if="{{b.icon === item.key}}">✓</view>
        </view>
      </view>
      <button class="btn-ghost sheet-close" hover-class="btn-hover" hover-stay-time="80"
        bindtap="closeIconMenu">先不选了</button>
    </view>
  </view>
</view>

<!-- 加载失败兜底 -->
<view class="page-load-fail wash-bg" wx:if="{{!b && loadFailed}}">
  <text class="fail-title">这座冰山暂时打不开</text>
  <text class="fail-sub">可能是网络不太好，等一会儿再试试</text>
  <button class="btn-primary fail-btn" hover-class="btn-hover" hover-stay-time="80"
    bindtap="load">重新打开</button>
  <button class="btn-ghost fail-btn" hover-class="btn-hover" hover-stay-time="80"
    bindtap="goBack">回到海洋</button>
</view>
