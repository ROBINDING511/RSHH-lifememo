<!--pages/iceberg/iceberg.wxml — 冰山详情
    适老化要点：
    - 正文 ≥40rpx，行高 1.9，段间距拉开，长文也好读
    - 播放原声按钮放大到 120rpx，配明确文字与播放态
    - 所有按钮 ≥104rpx 高；删除入口写"化成云"并说明可找回
    - 标记选择用大图标 + 文字，选中态不只靠颜色
-->
<view class="page wash-bg detail-enter" wx:if="{{b}}">
  <view class="berg-head card">
    <view class="berg-head-row">
      <input class="berg-title-input" value="{{b.title}}" maxlength="12"
        bindinput="onTitleInput" bindblur="saveTitle" />
      <view class="sea-badge" hover-class="btn-hover" hover-stay-time="80" bindtap="pickSea">
        <view class="sea-glyph"></view>
        <text class="sea-name">{{b.zoneName}}之海</text>
        <text class="sea-arrow">›</text>
      </view>
    </view>
    <text class="berg-meta" wx:if="{{timeLabel}}">{{timeLabel}}</text>
  </view>

  <view class="berg-body card">

    <!-- 逐字视图（一键还原逐字永远可用） -->
    <view wx:if="{{view === 'raw'}}" class="berg-text">
      <text>{{b.rawText || b.text}}</text>
    </view>

    <!-- 整理稿 / 疑点标注：E 翻书 -->
    <view wx:else class="book" bindtouchstart="onBookTouchStart" bindtouchend="onBookTouchEnd">
      <view class="book-page">
        <view wx:for="{{pages[page]}}" wx:key="*this" wx:for-item="si" class="sent-block">
          <view class="sent-text" data-i="{{si}}" bindtap="playSentence">
            <text wx:for="{{segs[si]}}" wx:key="index" wx:for-item="sg"
              class="{{sg.red ? 'doubt-word' : ''}}" data-id="{{sg.red}}" bindtap="openDoubt">{{sg.t}}</text>
          </view>
          <view class="sent-confirm" wx:if="{{view === 'clean'}}">
            <view class="sent-yes {{sentences[si].state === 'yes' ? 'on' : ''}}" hover-class="btn-hover" hover-stay-time="80" data-id="{{sentences[si].id}}" bindtap="confirmYes">像我说的</view>
            <view class="sent-no" hover-class="btn-hover" hover-stay-time="80" data-id="{{sentences[si].id}}" bindtap="confirmNo">不像</view>
          </view>
          <view class="sent-fix" wx:if="{{confirmExpand === sentences[si].id}}">
            <input class="fix-input" value="{{fixText}}" placeholder="您来说，或按住下面说" bindinput="onFixInput" />
            <view class="fix-hold {{fixing ? 'on' : ''}}" bindtouchstart="fixHoldStart" catchtouchend="fixHoldEnd" catchtouchcancel="fixHoldEnd">{{fixing ? '松开 完成' : '按住 说话纠正'}}</view>
            <view class="fix-ok" hover-class="btn-hover" hover-stay-time="80" data-id="{{sentences[si].id}}" bindtap="applyFix">按我说的改</view>
          </view>
        </view>
      </view>
      <view class="book-nav" wx:if="{{pageCount > 1}}">
        <view class="book-btn {{page === 0 ? 'dis' : ''}}" hover-class="btn-hover" hover-stay-time="80" bindtap="prevPage">上一页</view>
        <text class="book-pageno">第 {{page + 1}} / {{pageCount}} 页</text>
        <view class="book-btn {{page === pageCount - 1 ? 'dis' : ''}}" hover-class="btn-hover" hover-stay-time="80" bindtap="nextPage">下一页</view>
      </view>
    </view>
    <text class="sentence-hint" wx:if="{{b.audioFileID}}">点某一句，听那一句的原声</text>
    <!-- 右下角：切换识别模型（整理稿 ⇄ 逐字） -->
    <view class="model-switch" hover-class="btn-hover" hover-stay-time="80" bindtap="toggleView">
      <text class="ms-label">切换识别</text>
      <text class="ms-cur">{{view === 'raw' ? '逐字' : '整理稿'}}</text>
      <text class="ms-arrow">⇄</text>
    </view>

    <!-- 家人视角：反应回流 -->
    <view class="react-row" wx:if="{{familyMode}}">
      <view class="react-btn" hover-class="btn-hover" hover-stay-time="80" data-t="want" bindtap="react">想听</view>
      <view class="react-btn" hover-class="btn-hover" hover-stay-time="80" data-t="hug" bindtap="react">抱抱</view>
    </view>

    <view class="voice-row" wx:if="{{b.audioFileID}}"
      hover-class="voice-hover" hover-stay-time="80" bindtap="playVoice">
      <view class="voice-btn {{playing ? 'voice-on' : ''}}">
        <view class="voice-glyph {{playing ? 'voice-glyph-on' : ''}}"></view>
      </view>
      <view class="voice-label">
        <text class="voice-tip">{{playing ? '正在播放，点这里停' : '听听当时的声音'}}</text>
        <text class="voice-sub" wx:if="{{!playing}}">您当时说这段话的录音</text>
      </view>
    </view>
    <!-- B5 可拖动进度条 -->
    <view class="progress-row" wx:if="{{b.audioFileID}}">
      <slider class="progress" min="0" max="100" value="{{dur ? cur / dur * 100 : 0}}" block-size="20" activeColor="#1F6478" bindchange="onSeek" />
      <text class="progress-time">{{cur}}s / {{dur}}s</text>
    </view>
  </view>

  <view class="berg-photos card" wx:if="{{b.photos.length}}">
    <text class="photos-label">照片（点一下看大图）</text>
    <view class="photos-grid">
      <view class="photo-cell" wx:for="{{b.photos}}" wx:key="*this">
        <image class="photo-img" src="{{item}}" mode="aspectFill"
          data-src="{{item}}" bindtap="previewPhoto" />
      </view>
    </view>
  </view>

  <view class="actions safe-bottom">
    <button class="btn-primary" hover-class="btn-hover" hover-stay-time="80"
      bindtap="continueRecord">继续说 / 补录这段</button>
    <view class="actions-row">
      <button class="btn-ghost flex1" hover-class="btn-hover" hover-stay-time="80"
        bindtap="onShowIconMenu">放个标记</button>
      <button class="btn-ghost btn-danger-ghost flex1" hover-class="btn-hover" hover-stay-time="80"
        bindtap="meltIceberg">删除</button>
    </view>
  </view>

  <!-- 标记选择 -->
  <view class="icon-mask" wx:if="{{showIconMenu}}" bindtap="closeIconMenu">
    <view class="icon-sheet safe-bottom" catchtap="">
      <text class="sheet-title">选一个小标记，放上冰山</text>
      <text class="sheet-sub">标记是给自己看的记号，选哪个都行，之后还能换</text>
      <view class="icon-grid">
        <view class="icon-cell {{b.icon === item.key ? 'icon-cell-on' : ''}}"
          wx:for="{{icons}}" wx:key="key"
          hover-class="icon-hover" hover-stay-time="80"
          data-i="{{index}}" bindtap="pickIcon">
          <image class="icon-img" src="{{item.file}}" mode="aspectFit" />
          <text class="icon-name">{{item.name}}</text>
          <view class="icon-check" wx:if="{{b.icon === item.key}}">✓</view>
        </view>
      </view>
      <button class="btn-ghost sheet-close" hover-class="btn-hover" hover-stay-time="80"
        bindtap="closeIconMenu">先不选了</button>
    </view>
  </view>

  <!-- B4 红字点改 sheet -->
  <view class="icon-mask" wx:if="{{doubtSheet}}" bindtap="closeDoubt">
    <view class="icon-sheet safe-bottom" catchtap="">
      <text class="sheet-title">这个词听得准吗</text>
      <text class="doubt-ctx">{{doubtSheet.ctx}}</text>
      <view class="doubt-play" hover-class="btn-hover" hover-stay-time="80" bindtap="playDoubtLine">▶ 听这一句原声</view>
      <view class="doubt-cands">
        <view class="doubt-cand" wx:for="{{doubtSheet.candidates}}" wx:key="*this"
          hover-class="btn-hover" hover-stay-time="80" data-v="{{item}}" bindtap="pickCandidate">
          {{item}}<text class="cand-tag">{{doubtSheet.kind === 'number' ? '按算术' : '同音候选·未核实'}}</text>
        </view>
      </view>
      <view class="doubt-keep" hover-class="btn-hover" hover-stay-time="80" bindtap="keepOriginal">保留原词／原说</view>
      <input class="fix-input" value="{{doubtInput}}" placeholder="自己写" bindinput="onDoubtInput" />
      <view class="fix-ok" hover-class="btn-hover" hover-stay-time="80" bindtap="applyDoubt">确认改</view>
      <button class="btn-ghost sheet-close" hover-class="btn-hover" hover-stay-time="80" bindtap="closeDoubt">先不改</button>
    </view>
  </view>
</view>

<!-- 加载失败兜底 -->
<view class="page-load-fail wash-bg" wx:if="{{!b && loadFailed}}">
  <text class="fail-title">这座冰山暂时打不开</text>
  <text class="fail-sub">可能是网络不太好，等一会儿再试试</text>
  <button class="btn-primary fail-btn" hover-class="btn-hover" hover-stay-time="80"
    bindtap="load">重新打开</button>
  <button class="btn-ghost fail-btn" hover-class="btn-hover" hover-stay-time="80"
    bindtap="goBack">回到海洋</button>
</view>
<privacy-popup />
