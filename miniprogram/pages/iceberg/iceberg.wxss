/* pages/iceberg/iceberg.wxss */
.page { padding: 24rpx 32rpx 200rpx; }
.berg-head { margin-bottom: 24rpx; }
.berg-head-row { display: flex; align-items: center; gap: 24rpx; }
.berg-icon { width: 88rpx; height: 128rpx; }
.berg-title { font-size: 42rpx; font-weight: 500; color: #2C3E50; }
.berg-meta { display: block; font-size: 26rpx; color: #7A93A6; margin-top: 8rpx; }

.berg-body { margin-bottom: 24rpx; }
.berg-text { font-size: 40rpx; line-height: 1.8; color: #2C3E50; }
.voice-row { display: flex; align-items: center; gap: 20rpx; margin-top: 28rpx; }
.voice-btn {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: #E1F0F9; display: flex; align-items: center; justify-content: center;
}
.voice-on { background: #BFE0F2; }
.voice-whale { width: 64rpx; height: 64rpx; }
.voice-tip { font-size: 30rpx; color: #4A9BD1; }

.berg-photos { display: flex; flex-wrap: wrap; gap: 16rpx; }
.photo-img { width: 200rpx; height: 200rpx; border-radius: 20rpx; }

.actions {
  position: fixed; left: 32rpx; right: 32rpx; bottom: 40rpx;
  display: flex; gap: 24rpx;
}
.flex1 { flex: 1; }
.melt { color: #EB5757; }

.icon-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(44,62,80,0.4); display: flex; align-items: flex-end;
}
.icon-sheet {
  width: 100%; background: #fff; border-radius: 48rpx 48rpx 0 0;
  padding: 40rpx 32rpx; box-sizing: border-box;
}
.sheet-title { font-size: 34rpx; font-weight: 500; color: #2C3E50; }
.icon-grid { display: flex; flex-wrap: wrap; gap: 24rpx; margin-top: 32rpx; }
.icon-cell {
  width: 150rpx; display: flex; flex-direction: column; align-items: center;
  background: #F2F9FD; border-radius: 24rpx; padding: 20rpx 0;
}
.icon-img { width: 72rpx; height: 96rpx; }
.icon-name { font-size: 26rpx; color: #7A93A6; margin-top: 10rpx; }
