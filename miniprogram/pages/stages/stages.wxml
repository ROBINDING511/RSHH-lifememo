<!--pages/stages/stages.wxml — 杭航主菜单：关于我 / 我的海 / AI+ / 家人共建 + 回收站图标-->
<view class="page wash-bg">
  <view class="head">
    <text class="title">杭航</text>
  </view>

  <!-- 搜索框：搜全部回忆 -->
  <view class="search-box">
    <input class="search-input" value="{{searchQ}}" placeholder="搜回忆：标题 / 内容 / 哪片海 / 年份" bindinput="onSearch" confirm-type="search" />
    <view class="search-clear" wx:if="{{searchQ}}" hover-class="btn-hover" hover-stay-time="80" bindtap="clearSearch">×</view>
  </view>
  <view class="search-results" wx:if="{{searchQ}}">
    <view class="search-item" wx:for="{{searchResults}}" wx:key="_id" hover-class="btn-hover" hover-stay-time="80" data-id="{{item._id}}" bindtap="goDetail">
      <text class="search-title">{{item.title}}</text>
      <text class="search-meta">{{item.memoryTime}} · {{item.zoneName}}之海</text>
    </view>
    <view class="search-empty" wx:if="{{!searchResults.length}}">没找到相关回忆</view>
  </view>

  <view wx:if="{{!searchQ}}">
  <!-- 一级：关于我 -->
  <view class="menu-group">
    <view class="menu-l1" hover-class="btn-hover" hover-stay-time="80" data-k="about" bindtap="toggleMenu">
      <text class="menu-l1-t">关于我</text>
    </view>
    <view class="menu-l2" wx:if="{{openMenu === 'about'}}">
      <view class="menu-link" hover-class="btn-hover" hover-stay-time="80" bindtap="toggleNick">怎么称呼你{{nickname ? '：' + nickname : ''}}</view>
      <view class="card" wx:if="{{showNick}}">
        <input class="field" type="nickname" value="{{nickname}}" placeholder="点一下可填微信昵称，或自己写" bindinput="onNick" />
        <view class="prof-save" hover-class="btn-hover" hover-stay-time="80" bindtap="saveNick">记好了</view>
      </view>
      <view class="menu-link" hover-class="btn-hover" hover-stay-time="80" bindtap="togglePeople">熟人名字{{peopleList.length ? '：' + peopleList.join('、') : ''}}</view>
      <view class="card" wx:if="{{showPeople}}">
        <text class="ms-invite">常提到的人名写在这里，识别和整理会优先用这些写法。</text>
        <view class="ms-add">
          <input class="ms-input ms-name-input" value="{{personInput}}" placeholder="如 建国 / 秀兰" bindinput="onPersonInput" />
          <view class="ms-add-btn" hover-class="btn-hover" hover-stay-time="80" bindtap="addPerson">添加</view>
        </view>
        <view class="people-chips">
          <view class="people-chip" wx:for="{{peopleList}}" wx:key="*this">
            <text>{{item}}</text>
            <view class="ms-del" hover-class="btn-hover" hover-stay-time="80" data-n="{{item}}" bindtap="removePerson">×</view>
          </view>
        </view>
      </view>
      <!-- 出生年月：点按直接进滚轮（年/月/日），可不选；一旦确认即完整 -->
      <picker mode="date" value="{{profileBirthday || '1960-01-01'}}" start="1900-01-01" end="2020-12-31" bindchange="onBirthdayPick">
        <view class="menu-link">出生年月{{profileBirthday ? '：' + profileBirthday : '（点一下滚轮选）'}}</view>
      </picker>
    </view>
  </view>

  <!-- 一级：我的海 -->
  <view class="menu-group">
    <view class="menu-l1" hover-class="btn-hover" hover-stay-time="80" data-k="sea" bindtap="toggleMenu">
      <text class="menu-l1-t">我的海</text>
    </view>
    <view class="menu-l2" wx:if="{{openMenu === 'sea'}}">
      <view class="card">
        <text class="prof-title">人生节点</text>
        <view class="voice-hold {{listening ? 'on' : ''}}"
          bindtouchstart="onNodeStart" catchtouchend="onNodeEnd" catchtouchcancel="onNodeEnd">
          <text>{{listening ? '松开，自动填好' : '按住 聆听人生节点'}}</text>
        </view>
        <text class="voice-text" wx:if="{{voiceText}}">{{voiceText}}</text>
        <view class="ms-list">
          <view wx:for="{{milestones}}" wx:key="id" class="ms-row">
            <view class="ms-when">
              <text class="ms-date">{{item.date || (item.year + '年')}}</text>
              <text class="ms-age" wx:if="{{item.age != null}}">{{item.age}}岁</text>
            </view>
            <text class="ms-name">{{item.name}}</text>
            <view class="ms-del" hover-class="btn-hover" hover-stay-time="80" data-id="{{item.id}}" bindtap="removeMs">×</view>
          </view>
          <view wx:if="{{!milestones.length}}" class="ms-empty">按住上面，一次说几个节点</view>
        </view>
      </view>
      <view class="menu-link" hover-class="btn-hover" hover-stay-time="80" bindtap="goTimeline">时间轴（按年翻一生）</view>
      <view class="menu-link" hover-class="btn-hover" hover-stay-time="80" bindtap="exportBook">导出回忆录（按年文稿+原声）</view>
    </view>
  </view>

  <!-- 一级：AI+（AI 识别的风格 / 声音克隆） -->
  <view class="menu-group">
    <view class="menu-l1" hover-class="btn-hover" hover-stay-time="80" data-k="ai" bindtap="toggleMenu">
      <text class="menu-l1-t">AI+</text>
    </view>
    <view class="menu-l2" wx:if="{{openMenu === 'ai'}}">
      <view class="card">
        <text class="prof-title">AI 识别的风格</text>
        <text class="ms-invite">帮您顺文字时按您选的来；原话和原声永远保留。</text>
        <view class="style-row">
          <view class="style-opt {{polishStyle === 'verbatim' ? 'on' : ''}}" hover-class="btn-hover" hover-stay-time="80" data-s="verbatim" bindtap="setStyle">忠实原文</view>
          <view class="style-opt {{polishStyle === 'light' ? 'on' : ''}}" hover-class="btn-hover" hover-stay-time="80" data-s="light" bindtap="setStyle">轻度优化·尽量保留原话</view>
          <view class="style-opt {{polishStyle === 'written' ? 'on' : ''}}" hover-class="btn-hover" hover-stay-time="80" data-s="written" bindtap="setStyle">口语顺成书面语</view>
        </view>
      </view>
      <view class="menu-link clone-row">
        <text>声音克隆</text>
        <view class="clone-switch {{cloneConsent ? 'on' : ''}}" hover-class="btn-hover" hover-stay-time="80" catchtap="toggleCloneSwitch">
          <view class="clone-knob"></view>
        </view>
      </view>
      <view class="card" wx:if="{{cloneConsent}}">
        <text class="prof-title">妈妈的声音（克隆）</text>
        <text class="ms-invite">{{voiceState==='frozen' ? '已固化：不再自动克隆；删除后会重新克隆。' : voiceState==='review' ? '克隆好了，回海洋听听像不像。' : '正在收集您的声音，自动克隆中…'}}</text>
        <view class="ms-add" wx:if="{{voiceSampleUrl}}">
          <view class="ms-add-btn" style="flex:1" hover-class="btn-hover" hover-stay-time="80" bindtap="playVoiceSample">试听克隆声音</view>
          <view class="ms-add-btn" style="flex:1;background:var(--c-danger-soft);color:var(--c-danger)" hover-class="btn-hover" hover-stay-time="80" bindtap="deleteVoice">删除声音</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 一级：家人共建 -->
  <view class="menu-group">
    <view class="menu-l1" hover-class="btn-hover" hover-stay-time="80" data-k="family" bindtap="toggleMenu">
      <text class="menu-l1-t">家人共建</text>
    </view>
    <view class="menu-l2" wx:if="{{openMenu === 'family'}}">
      <view class="card">
        <text class="prof-title">邀请 / 绑定 / 投喂</text>
        <text class="ms-invite">邀请孩子后，孩子可看你的海、投喂问题、点"想听/抱抱"回流给你。</text>
        <view class="ms-add">
          <view class="ms-add-btn" style="flex:1" hover-class="btn-hover" hover-stay-time="80" bindtap="inviteFamily">生成邀请码</view>
        </view>
        <view class="ms-add" wx:if="{{inviteCode}}">
          <text class="invite-code">邀请码：{{inviteCode}}（给孩子填）</text>
        </view>
        <view class="ms-add">
          <input class="ms-input ms-name-input" value="{{bindCode}}" placeholder="我是家人，填邀请码" bindinput="onBindCode" />
          <view class="ms-add-btn" hover-class="btn-hover" hover-stay-time="80" bindtap="bindFamily">绑定</view>
        </view>
        <view class="ms-add">
          <input class="ms-input ms-name-input" value="{{feedQ}}" placeholder="投喂一个问题给妈妈" bindinput="onFeedQ" />
          <view class="ms-add-btn" hover-class="btn-hover" hover-stay-time="80" bindtap="feedQuestion">投喂</view>
        </view>
      </view>
    </view>
  </view>
  </view>

  <!-- 回收站图标：一级菜单右下角 → 删除的记忆 -->
  <view class="recycle-fab" hover-class="btn-hover" hover-stay-time="80" bindtap="goRecycle" aria-label="删除的记忆">
    <view class="trash-lid"></view>
    <view class="trash-body"></view>
  </view>
  <view style="height:160rpx"></view>
</view>
<privacy-popup />
