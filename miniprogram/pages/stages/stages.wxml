<!--pages/stages/stages.wxml — 杭航主菜单（一级菜单 + 二级菜单）-->
<view class="page wash-bg">
  <view class="head">
    <text class="title">杭航</text>
    <text class="sub">小鲸鱼的主菜单 · 点一级展开二级</text>
  </view>

  <!-- 鲸鱼菜单快捷按钮：删除的记忆（5天内可找回） -->
  <view class="hub-row">
    <view class="hub-pill" hover-class="btn-hover" hover-stay-time="80" bindtap="goRecycle">删除的记忆</view>
  </view>

  <!-- 一级：我的海 -->
  <view class="menu-group">
    <view class="menu-l1" hover-class="btn-hover" hover-stay-time="80" data-k="sea" bindtap="toggleMenu">
      <text class="menu-l1-t">我的海</text>
      <text class="menu-l1-x">{{openMenu === 'sea' ? '收起' : '展开'}}</text>
    </view>
    <view class="menu-l2" wx:if="{{openMenu === 'sea'}}">
      <view class="card">
        <text class="prof-title">二级 · 几片海、叫什么、到几岁</text>
        <view class="stage-bar">
          <view wx:for="{{stages}}" wx:key="key" class="seg"
            style="left:{{item.from}}%;width:{{item.dispTo-item.from+1}}%;background:{{item.color}}"></view>
        </view>
        <view class="stage-rows">
          <view wx:for="{{stages}}" wx:key="key" class="stage-row2">
            <view class="stage-swatch" style="background:{{item.color}}"></view>
            <input class="name-box" value="{{item.name}}" data-i="{{index}}" bindinput="onNameInput" />
            <text class="range-from">{{item.from}}</text>
            <text class="dash">–</text>
            <input wx:if="{{index < stages.length-1}}" class="num-box" type="number" value="{{item.to}}" data-i="{{index}}" bindinput="onToInput" />
            <text wx:else class="num-box num-open">以后</text>
            <view class="ms-del" hover-class="btn-hover" hover-stay-time="80" data-i="{{index}}" bindtap="removeSea">×</view>
          </view>
        </view>
        <view class="add-sea" hover-class="btn-hover" hover-stay-time="80" bindtap="addSea">＋ 加一片海</view>
      </view>

      <view class="card">
        <text class="prof-title">二级 · 人生节点＝海的开端</text>
        <text class="ms-invite">每个转折点开启一片新的海；删掉节点，两片海合并。</text>
        <view class="ms-list">
          <view wx:for="{{milestones}}" wx:key="id" class="ms-row">
            <text class="ms-age">{{item.age}}岁</text>
            <text class="ms-name">{{item.name}}</text>
            <view class="ms-del" hover-class="btn-hover" hover-stay-time="80" data-id="{{item.id}}" bindtap="removeMs">×</view>
          </view>
          <view wx:if="{{!milestones.length}}" class="ms-empty">还没有节点，加一个试试</view>
        </view>
        <view class="ms-add">
          <input class="ms-input ms-name-input" value="{{msName}}" placeholder="比如 孩子出生" bindinput="onMsName" />
          <input class="ms-input ms-age-input" type="number" value="{{msAge}}" placeholder="几岁" bindinput="onMsAge" />
          <view class="ms-add-btn" hover-class="btn-hover" hover-stay-time="80" bindtap="addMs">添加</view>
        </view>
      </view>

      <view class="card">
        <text class="prof-title">二级 · 怎么称呼你</text>
        <input class="field" type="nickname" value="{{nickname}}" placeholder="点一下可填微信昵称，或自己写" bindinput="onNick" />
        <view class="prof-save" hover-class="btn-hover" hover-stay-time="80" bindtap="saveNick">记好了</view>
      </view>

      <view class="card">
        <text class="prof-title">二级 · 你的年纪（把"…岁"换算成年份）</text>
        <view class="mode-tabs">
          <view class="tab {{profileMode==='birthday'?'on':''}}" hover-class="btn-hover" hover-stay-time="80" bindtap="setMode" data-m="birthday">生日</view>
          <view class="tab {{profileMode==='age'?'on':''}}" hover-class="btn-hover" hover-stay-time="80" bindtap="setMode" data-m="age">年龄</view>
          <view class="tab {{profileMode==='year'?'on':''}}" hover-class="btn-hover" hover-stay-time="80" bindtap="setMode" data-m="year">出生年份</view>
        </view>
        <picker wx:if="{{profileMode==='birthday'}}" mode="date" value="{{profileBirthday||'1960-01-01'}}" start="1900-01-01" end="2020-12-31" bindchange="onBirthdayPick">
          <view class="prof-input">{{profileBirthday||'点这里选生日'}}</view>
        </picker>
        <input wx:elif="{{profileMode==='age'}}" class="prof-input" type="number" value="{{profileAge}}" placeholder="比如 68" bindinput="onAgeInput" />
        <input wx:else class="prof-input" type="number" value="{{profileYear}}" placeholder="比如 1958" bindinput="onYearInput" />
        <view class="prof-save" hover-class="btn-hover" hover-stay-time="80" bindtap="saveProfile">记好了</view>
      </view>

      <view class="voice-hold {{listening?'on':''}}"
        bindtouchstart="onVoiceStart" catchtouchend="onVoiceEnd" catchtouchcancel="onVoiceEnd">
        <text>{{listening ? '松开，我听懂就设好' : '按住跟杭航说你的划分'}}</text>
      </view>
      <text class="voice-eg">比如："童年到18岁，青年到40岁"</text>
      <text class="voice-text" wx:if="{{voiceText}}">{{voiceText}}</text>

      <view class="btns">
        <view class="btn-reset" hover-class="btn-hover" hover-stay-time="80" bindtap="resetDefault">恢复默认</view>
        <view class="btn-save" hover-class="btn-hover" hover-stay-time="80" bindtap="saveAll">保存</view>
      </view>
    </view>
  </view>

  <!-- 一级：回忆梳理 -->
  <view class="menu-group">
    <view class="menu-l1" hover-class="btn-hover" hover-stay-time="80" data-k="recall" bindtap="toggleMenu">
      <text class="menu-l1-t">回忆梳理</text>
      <text class="menu-l1-x">{{openMenu === 'recall' ? '收起' : '展开'}}</text>
    </view>
    <view class="menu-l2" wx:if="{{openMenu === 'recall'}}">
      <view class="card">
        <text class="prof-title">二级 · AI 文字梳理风格</text>
        <text class="ms-invite">鲸鱼帮您顺文字时按您选的来；原话和原声永远保留，随时可还原。</text>
        <view class="style-row">
          <view class="style-opt {{polishStyle === 'verbatim' ? 'on' : ''}}" hover-class="btn-hover" hover-stay-time="80" data-s="verbatim" bindtap="setStyle">忠实原文</view>
          <view class="style-opt {{polishStyle === 'light' ? 'on' : ''}}" hover-class="btn-hover" hover-stay-time="80" data-s="light" bindtap="setStyle">轻度优化·尽量保留原话</view>
          <view class="style-opt {{polishStyle === 'written' ? 'on' : ''}}" hover-class="btn-hover" hover-stay-time="80" data-s="written" bindtap="setStyle">口语顺成书面语</view>
        </view>
      </view>
      <view class="menu-link" hover-class="btn-hover" hover-stay-time="80" bindtap="goTimeline">二级 · 时间轴（按年翻一生）</view>
    </view>
  </view>

  <!-- 一级：家人共建 -->
  <view class="menu-group">
    <view class="menu-l1" hover-class="btn-hover" hover-stay-time="80" data-k="family" bindtap="toggleMenu">
      <text class="menu-l1-t">家人共建</text>
      <text class="menu-l1-x">{{openMenu === 'family' ? '收起' : '展开'}}</text>
    </view>
    <view class="menu-l2" wx:if="{{openMenu === 'family'}}">
      <view class="card">
        <text class="prof-title">二级 · 邀请 / 绑定 / 投喂</text>
        <text class="ms-invite">邀请孩子后，孩子可看你的海、投喂问题、点"想听/抱抱"回流给你。</text>
        <view class="ms-add">
          <view class="ms-add-btn" style="flex:1" hover-class="btn-hover" hover-stay-time="80" bindtap="inviteFamily">生成邀请码</view>
        </view>
        <view class="ms-add" wx:if="{{inviteCode}}">
          <text class="invite-code">邀请码：{{inviteCode}}（给孩子填）</text>
        </view>
        <view class="ms-add">
          <input class="ms-input ms-name-input" value="{{bindCode}}" placeholder="我是家人，填邀请码" bindinput="onBindCode" />
          <view class="ms-add-btn" hover-class="btn-hover" hover-stay-time="80" bindtap="bindFamily">绑定</view>
        </view>
        <view class="ms-add">
          <input class="ms-input ms-name-input" value="{{feedQ}}" placeholder="投喂一个问题给妈妈" bindinput="onFeedQ" />
          <view class="ms-add-btn" hover-class="btn-hover" hover-stay-time="80" bindtap="feedQuestion">投喂</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 一级：声音 -->
  <view class="menu-group">
    <view class="menu-l1" hover-class="btn-hover" hover-stay-time="80" data-k="sound" bindtap="toggleMenu">
      <text class="menu-l1-t">声音</text>
      <text class="menu-l1-x">{{openMenu === 'sound' ? '收起' : '展开'}}</text>
    </view>
    <view class="menu-l2" wx:if="{{openMenu === 'sound'}}">
      <view class="card" wx:if="{{voiceState}}">
        <text class="prof-title">二级 · 妈妈的声音（克隆）</text>
        <text class="ms-invite">{{voiceState==='frozen' ? '已固化：不再自动克隆；删除后会重新克隆。' : voiceState==='review' ? '克隆好了，回海洋听听像不像。' : '正在收集您的声音，自动克隆中…'}}</text>
        <view class="ms-add" wx:if="{{voiceSampleUrl}}">
          <view class="ms-add-btn" style="flex:1" hover-class="btn-hover" hover-stay-time="80" bindtap="playVoiceSample">试听克隆声音</view>
          <view class="ms-add-btn" style="flex:1;background:var(--c-danger-soft);color:var(--c-danger)" hover-class="btn-hover" hover-stay-time="80" bindtap="deleteVoice">删除声音</view>
        </view>
      </view>

      <view class="menu-link" hover-class="btn-hover" hover-stay-time="80" bindtap="toggleCloneConsent">二级 · 允许克隆我的声音：{{cloneConsent ? '已同意' : '未同意'}}</view>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>