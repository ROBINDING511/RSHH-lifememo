/* pages/stages/stages.wxss — 人生阶段规划 */
.page { min-height: 100vh; padding: 24rpx 32rpx 40rpx; box-sizing: border-box; }
.head { padding: 8rpx 4rpx 20rpx; }
.title { display: block; font-size: var(--fs-xl); font-weight: 600; color: var(--c-text); }
.sub { display: block; font-size: var(--fs-sm); color: var(--c-text-2); margin-top: 8rpx; }
.card { margin-bottom: 24rpx; }
.prof-title { display: block; font-size: var(--fs-sm); color: var(--c-text-2); font-weight: 500; margin-bottom: 16rpx; }
.mode-tabs { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.tab { flex: 1; min-height: 72rpx; display: flex; align-items: center; justify-content: center; background: var(--c-soft); color: var(--c-text-2); border-radius: 36rpx; font-size: var(--fs-sm); }
.tab.on { background: var(--c-primary); color: #fff; }
.prof-input { min-height: 88rpx; display: flex; align-items: center; justify-content: center; background: var(--c-soft); border: 2rpx solid rgba(31,100,120,.15); border-radius: var(--radius-md); color: var(--c-primary); font-size: var(--fs-md); font-weight: 500; text-align: center; }
.prof-save { margin-top: 16rpx; min-height: 80rpx; display: flex; align-items: center; justify-content: center; background: linear-gradient(160deg,#2E7C93,#1F6478); color: #fff; border-radius: 40rpx; font-size: var(--fs-md); }

.stage-bar { position: relative; height: 56rpx; margin: 56rpx 8rpx 20rpx; border-radius: 28rpx; overflow: visible; background: var(--c-soft); }
.seg { position: absolute; top: 0; height: 100%; }
.seg:first-child { border-radius: 28rpx 0 0 28rpx; }
.handle { position: absolute; top: -40rpx; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; padding: 0 12rpx; }
.handle-age { font-size: var(--fs-xs); color: var(--c-text); font-weight: 600; background: rgba(255,255,255,.85); border-radius: 20rpx; padding: 2rpx 14rpx; }
.handle-dot { width: 28rpx; height: 56rpx; margin-top: 4rpx; border-radius: 14rpx; background: #fff; border: 4rpx solid var(--c-primary); box-sizing: border-box; box-shadow: 0 2rpx 8rpx rgba(23,80,95,.3); }
.stage-list { margin-top: 12rpx; }
.stage-row { display: flex; align-items: center; gap: 16rpx; min-height: 64rpx; }
.stage-swatch { width: 32rpx; height: 32rpx; border-radius: 8rpx; }
.stage-name { flex: 1; font-size: var(--fs-md); color: var(--c-text); }
.stage-range { font-size: var(--fs-sm); color: var(--c-text-2); }

.voice-hold { margin: 8rpx 0 12rpx; min-height: 96rpx; display: flex; align-items: center; justify-content: center; background: linear-gradient(160deg,#2E7C93,#1F6478); color: #fff; border-radius: 48rpx; font-size: var(--fs-md); font-weight: 500; }
.voice-hold.on { background: linear-gradient(160deg,#C4574A,#B3402F); }
.voice-eg { display: block; text-align: center; font-size: var(--fs-xs); color: var(--c-text-2); }
.voice-text { display: block; margin-top: 12rpx; font-size: var(--fs-sm); color: var(--c-text); background: var(--c-card); border-radius: var(--radius-md); padding: 16rpx 20rpx; }
.btns { display: flex; gap: 24rpx; margin-top: 32rpx; }
.btn-reset { flex: 1; min-height: 88rpx; display: flex; align-items: center; justify-content: center; background: var(--c-soft); color: var(--c-text-2); border-radius: 44rpx; font-size: var(--fs-md); }
.btn-save { flex: 1; min-height: 88rpx; display: flex; align-items: center; justify-content: center; background: linear-gradient(160deg,#2E7C93,#1F6478); color: #fff; border-radius: 44rpx; font-size: var(--fs-md); font-weight: 500; }