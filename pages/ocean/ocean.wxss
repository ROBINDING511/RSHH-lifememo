/* pages/ocean/ocean.wxss */
.page { width: 100vw; height: 100vh; position: relative; overflow: hidden; }
.ocean-canvas { width: 100vw; height: 100vh; }

.top-bar {
  position: absolute; top: 24rpx; right: 24rpx;
  display: flex; gap: 20rpx;
}
.top-btn {
  display: flex; flex-direction: column; align-items: center;
  background: rgba(255,255,255,0.85); border-radius: 20rpx;
  padding: 10rpx 22rpx; font-size: 24rpx; color: #3E6B8A;
}
.top-icon { width: 44rpx; height: 44rpx; }

.zone-header {
  position: absolute; top: 24rpx; left: 24rpx;
  display: flex; align-items: center; gap: 20rpx;
  background: rgba(255,255,255,0.85); border-radius: 32rpx;
  padding: 12rpx 28rpx;
}
.back-btn { color: #4A9BD1; font-size: 30rpx; }
.zone-name { color: #2C3E50; font-size: 32rpx; font-weight: 500; }

.empty-hint {
  position: absolute; left: 0; right: 0; top: 22%;
  display: flex; flex-direction: column; align-items: center;
  pointer-events: none;
}
.hint-title { font-size: 40rpx; color: #3E6B8A; font-weight: 500; }
.hint-sub { font-size: 28rpx; color: #7A93A6; margin-top: 12rpx; }

/* 录音 */
.record-mask {
  position: absolute; left: 0; right: 0; bottom: 0; top: 0;
  display: flex; flex-direction: column; justify-content: flex-end;
  background: rgba(226,242,251,0.35); pointer-events: none;
}
.transcript-box {
  margin: 0 32rpx 24rpx; background: rgba(255,255,255,0.92);
  border-radius: 32rpx; padding: 28rpx 32rpx; min-height: 120rpx;
  box-shadow: 0 8rpx 32rpx rgba(74,155,209,0.18);
}
.transcript-scroll { max-height: 320rpx; }
.transcript { font-size: 40rpx; line-height: 1.7; color: #2C3E50; }
.record-tip {
  display: flex; justify-content: center; margin-bottom: 120rpx;
}
.countdown { color: #EB5757; font-size: 36rpx; font-weight: 500; }
.tip-text { color: #3E6B8A; font-size: 34rpx; }

/* 分析中 */
.analyze-mask {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: rgba(232,244,251,0.8);
}
.loading-whale { width: 220rpx; height: 140rpx; margin-bottom: 24rpx; }

/* 发布卡片 */
.preview-mask {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(44,62,80,0.35);
  display: flex; align-items: flex-end;
}
.preview-card {
  width: 100%; background: #fff; border-radius: 48rpx 48rpx 0 0;
  padding: 40rpx 36rpx 40rpx; box-sizing: border-box;
}
.preview-head { margin-bottom: 20rpx; }
.preview-title { font-size: 36rpx; font-weight: 500; color: #2C3E50; }
.preview-text {
  width: 100%; min-height: 160rpx; font-size: 38rpx; line-height: 1.7;
  padding: 24rpx; box-sizing: border-box; background: #F2F9FD; border-radius: 24rpx;
}
.option-group { margin-top: 28rpx; }
.option-label { font-size: 28rpx; color: #7A93A6; }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 12rpx; }
.chip {
  background: #F2F9FD; color: #4A9BD1; border-radius: 32rpx;
  padding: 10rpx 30rpx; font-size: 30rpx;
}
.chip-on { background: #4A9BD1; color: #fff; }

.photo-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 28rpx; }
.photo-cell { position: relative; }
.photo-img { width: 180rpx; height: 180rpx; border-radius: 20rpx; }
.photo-del {
  position: absolute; top: -10rpx; right: -10rpx;
  background: rgba(0,0,0,0.5); color: #fff; border-radius: 50%;
  width: 40rpx; height: 40rpx; text-align: center; line-height: 40rpx; font-size: 28rpx;
}
.photo-add {
  width: 180rpx; height: 180rpx; border-radius: 20rpx;
  background: #F2F9FD; color: #4A9BD1; font-size: 60rpx;
  display: flex; align-items: center; justify-content: center;
}
.preview-actions { display: flex; gap: 24rpx; margin-top: 40rpx; }
.flex1 { flex: 1; }
